<style is:global>
.wohncontainer {
	--wc-linie: var(--color-text, #1c1d1e);
	--wc-oben: color-mix(in srgb, var(--color-text, #1c1d1e) 4%, var(--color-bg, #fff));
	--wc-links: color-mix(in srgb, var(--color-text, #1c1d1e) 12%, var(--color-bg, #fff));
	--wc-rechts: color-mix(in srgb, var(--color-text, #1c1d1e) 24%, var(--color-bg, #fff));
	--wc-boden: color-mix(in srgb, var(--color-text, #1c1d1e) 14%, var(--color-bg, #fff));
	--wc-glas: color-mix(in srgb, #6f8a99 38%, var(--color-bg, #fff));
	--wc-glas-quer: color-mix(in srgb, #6f8a99 55%, var(--color-bg, #fff));
	--wc-holz: color-mix(in srgb, #a07850 45%, var(--color-bg, #fff));
	--wc-gruen: color-mix(in srgb, #5f7a5a 55%, var(--color-bg, #fff));
	--wc-licht: #f6d79a;
	display: block;
	width: 100%;
	max-width: 760px;
	margin-inline: auto;
}
.wohncontainer svg { display: block; width: 100%; height: auto; overflow: visible; }

/* Flächen und Linien */
.wohncontainer polygon, .wohncontainer ellipse { stroke: var(--wc-linie); stroke-width: 1.1; stroke-linejoin: round; }
.wohncontainer line { stroke: var(--wc-linie); stroke-linecap: round; }
.wohncontainer .f-oben { fill: var(--wc-oben); }
.wohncontainer .f-links { fill: var(--wc-links); }
.wohncontainer .f-rechts { fill: var(--wc-rechts); }
.wohncontainer .holz.f-oben { fill: var(--wc-holz); }
.wohncontainer .holz.f-links, .wohncontainer .holz.f-rechts { fill: color-mix(in srgb, var(--wc-holz) 70%, #000); }
.wohncontainer .stuetze { fill: var(--wc-rechts); }
.wohncontainer .rille { stroke-width: 0.6; opacity: 0.45; }
.wohncontainer .boden { stroke: var(--wc-boden); stroke-width: 1; stroke-dasharray: 1; }
.wohncontainer .schatten { fill: var(--wc-linie); stroke: none; opacity: 0.07; }
.wohncontainer .fundament { fill: var(--wc-rechts); stroke-width: 0.8; }
.wohncontainer .glas { fill: var(--wc-glas); stroke: none; }
.wohncontainer .g-quer { fill: var(--wc-glas-quer); }
.wohncontainer .licht { fill: var(--wc-licht); stroke: none; opacity: 0; }
.wohncontainer .rahmen { fill: none; stroke-width: 1.6; }
.wohncontainer .sprosse { stroke-width: 1.2; }
.wohncontainer .spiegel { stroke: #fff; stroke-width: 2.5; opacity: 0.5; }
.wohncontainer .diele { stroke-width: 0.5; opacity: 0.5; }
.wohncontainer .gelaender { stroke-width: 1.1; }
.wohncontainer .kante { stroke-width: 1.1; }
.wohncontainer .stamm { stroke-width: 2.2; }
.wohncontainer .krone { fill: var(--wc-gruen); }
.wohncontainer .krone.k2 { fill: color-mix(in srgb, var(--wc-gruen) 80%, #000); }

/* ---------- Ablauf ----------
   Ohne JavaScript oder mit reduzierter Bewegung bleibt das fertige Bild
   stehen. Das Skript setzt "wartet" (Startbild) und startet die
   Animation mit "laeuft", sobald sie im Bild ist. */
.wohncontainer.wartet *, .wohncontainer.wartet { animation-play-state: paused !important; }

.wohncontainer.animiert .boden { animation: wc-zeichnen 1.1s cubic-bezier(.4,0,.2,1) both; }
.wohncontainer.animiert .s-schatten { animation: wc-ein .8s 1.3s both; }
.wohncontainer.animiert .s-fundament polygon { animation: wc-ein .4s .8s both; }
.wohncontainer.animiert .m1 .fall { animation: wc-fallen 1s 1s cubic-bezier(.22,.9,.3,1.12) both; }
.wohncontainer.animiert .r1 .rille { animation: wc-zeichnen .8s 1.9s ease-out both; }
.wohncontainer.animiert .f1 { animation: wc-ein .7s 2.3s both; }
.wohncontainer.animiert .s-terrasse { animation: wc-schieben .7s 2.7s cubic-bezier(.2,.8,.2,1) both; }
.wohncontainer.animiert .m2 .fall { animation: wc-fallen 1s 3.1s cubic-bezier(.22,.9,.3,1.12) both; }
.wohncontainer.animiert .s-stuetze { animation: wc-ein .4s 3.9s both; }
.wohncontainer.animiert .r2 .rille { animation: wc-zeichnen .8s 4s ease-out both; }
.wohncontainer.animiert .f2 { animation: wc-ein .7s 4.3s both; }
.wohncontainer.animiert .gelaender { animation: wc-zeichnen .5s 4.6s ease-out both; }
.wohncontainer.animiert .s-baum .wachsen { animation: wc-wachsen .9s 4.9s cubic-bezier(.3,1.4,.5,1) both; }
.wohncontainer.animiert .s-busch .wachsen { animation: wc-wachsen .8s 5.1s cubic-bezier(.3,1.4,.5,1) both; }
.wohncontainer.animiert .licht { animation: wc-licht 1.4s 5.7s ease-in-out both; }

.wohncontainer .boden, .wohncontainer .rille, .wohncontainer .gelaender { stroke-dasharray: 1; stroke-dashoffset: 0; }
.wohncontainer.fertig .licht { opacity: .32; }

@keyframes wc-zeichnen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
@keyframes wc-ein { from { opacity: 0; } }
@keyframes wc-fallen { 0% { transform: translateY(-140px); opacity: 0; } 25% { opacity: 1; } 100% { transform: translateY(0); } }
@keyframes wc-schieben { from { transform: translate(-18px, 10px); opacity: 0; } }
@keyframes wc-wachsen { from { transform: scale(0); } }
@keyframes wc-licht { from { opacity: 0; } to { opacity: .32; } }

@media (prefers-reduced-motion: reduce) {
	.wohncontainer.animiert *, .wohncontainer.animiert { animation: none !important; }
	.wohncontainer .licht { opacity: .32; }
}
</style>

<script>
document.querySelectorAll("[data-wohncontainer]").forEach((el) => {
	if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
	el.classList.add("animiert", "wartet");
	const start = () => {
		el.classList.remove("animiert", "fertig");
		void el.getBoundingClientRect();
		el.classList.add("animiert");
		el.classList.remove("wartet");
	};
	el.addEventListener("animationend", (e) => {
		if (e.animationName === "wc-licht") el.classList.add("fertig");
	});
	const io = new IntersectionObserver((eintraege) => {
		if (eintraege.some((e) => e.isIntersecting)) { start(); io.disconnect(); }
	}, { threshold: 0.35 });
	io.observe(el);
	el.wohncontainerNeu = start;
});
</script>
