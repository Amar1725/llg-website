---
// Detailseite für ein Haus: Titelbild über die ganze Breite mit Titel,
// danach Beschreibung und Eckdaten, dann die Bildergalerie.
import { getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import { Form } from "@emdash-cms/plugin-forms/ui";
import "@emdash-cms/plugin-forms/styles";
import Base from "../../layouts/Base.astro";
import { bildUrl, kurzText } from "../../lib/teilen";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: haus, cacheHint } = await getEmDashEntry("hauser", slug);
if (!haus) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(haus, {
	siteUrl: Astro.url.origin,
	path: `/haeuser/${slug}`,
});

const d = haus.data as any;
const zahl = new Intl.NumberFormat("de-CH");
const eckdatenKurz = [
	d.ort,
	d.zimmer != null && `${d.zimmer} Zimmer`,
	d.wohnflaeche != null && `${zahl.format(d.wohnflaeche)} m² Wohnfläche`,
].filter(Boolean).join(", ");
const teilenText = [eckdatenKurz, kurzText(d.beschreibung, 150)].filter(Boolean).join(". ");
const teilenBild = bildUrl(d.titelbild, Astro.url.origin);
const galerie: any[] = Array.isArray(d.galerie) ? d.galerie.filter((row: any) => row?.bild) : [];

const eckdaten = [
	d.ort && { label: "Ort", wert: d.ort },
	d.zimmer != null && { label: "Zimmer", wert: String(d.zimmer) },
	d.wohnflaeche != null && { label: "Wohnfläche", wert: `${zahl.format(d.wohnflaeche)} m²` },
	d.grundstueck != null && { label: "Grundstück", wert: `${zahl.format(d.grundstueck)} m²` },
].filter(Boolean) as { label: string; wert: string }[];
---

<Base
	title={seo.title || d.title}
	description={seo.description || teilenText}
	image={seo.ogImage || teilenBild}
	canonical={seo.canonical}
	content={{ collection: "hauser", id: d.id, slug: haus.id }}
>
	<article>
		<header class:list={["kopf", { "ohne-bild": !d.titelbild }]}>
			{
				d.titelbild && (
					<div class="kopf-bild" {...haus.edit.titelbild}>
						<Image image={d.titelbild} />
					</div>
				)
			}
			<div class="kopf-text container">
				{d.ort && <p class="ort" {...haus.edit.ort}>{d.ort}</p>}
				<h1 {...haus.edit.title}>{d.title}</h1>
			</div>
		</header>

		<div class="inhalt container">
			<div class="beschreibung" {...haus.edit.beschreibung}>
				<a href="/#haeuser" class="zurueck">Alle Häuser</a>
				{d.beschreibung ? <PortableText value={d.beschreibung} /> : null}
			</div>

			<aside class="seite">
				{
					eckdaten.length > 0 && (
						<dl class="eckdaten">
							{eckdaten.map((e) => (
								<div>
									<dt>{e.label}</dt>
									<dd>{e.wert}</dd>
								</div>
							))}
						</dl>
					)
				}
				<a href="#anfrage" class="btn btn-dunkel anfrage">Besichtigung anfragen</a>
			</aside>
		</div>

		{
			galerie.length > 0 && (
				<section class="galerie-bereich container" aria-label="Bildergalerie">
					<h2>Galerie</h2>
					<div class="galerie" {...haus.edit.galerie}>
						{galerie.map((row) => (
							<button type="button" class="galerie-bild" aria-label="Bild gross anzeigen">
								<Image image={row.bild} />
							</button>
						))}
					</div>
				</section>
			)
		}

		<section class="anfrage-bereich container" id="anfrage" data-haus={d.title}>
			<div class="anfrage-text">
				<h2>Besichtigung anfragen</h2>
				<p>Schreiben Sie uns, wann Sie das Haus ansehen möchten. Wir melden uns so rasch wie möglich bei Ihnen.</p>
			</div>
			<div class="anfrage-formular">
				<Form id="kontakt" />
			</div>
		</section>
	</article>

	<dialog class="lightbox" aria-label="Bildansicht">
		<img alt="" />
		<button type="button" class="schliessen" aria-label="Schliessen">✕</button>
	</dialog>

	<script>
		const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
		const grossesBild = dialog?.querySelector("img");
		document.querySelectorAll<HTMLButtonElement>(".galerie-bild").forEach((btn) => {
			btn.addEventListener("click", () => {
				const img = btn.querySelector("img");
				if (!dialog || !grossesBild || !img) return;
				grossesBild.src = img.currentSrc || img.src;
				grossesBild.alt = img.alt;
				dialog.showModal();
			});
		});
		dialog?.addEventListener("click", () => dialog.close());

		// Hausname automatisch ins (versteckte) Feld "haus" des Formulars schreiben
		const bereich = document.querySelector<HTMLElement>("#anfrage");
		const hausFeld = bereich?.querySelector<HTMLInputElement>('[name="haus"]');
		if (bereich && hausFeld && !hausFeld.value) hausFeld.value = bereich.dataset.haus ?? "";
	</script>
</Base>

<style>
	.kopf {
		position: relative;
		min-height: 78vh;
		display: flex;
		align-items: flex-end;
		color: #ffffff;
		background: #1c1d1e;
		overflow: hidden;
	}

	.kopf.ohne-bild {
		min-height: 40vh;
		color: var(--color-text);
		background: var(--color-surface);
	}

	.kopf-bild {
		position: absolute;
		inset: 0;
	}

	.kopf-bild :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
	}

	.kopf-bild::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.05) 55%);
		pointer-events: none;
	}

	.kopf-text {
		position: relative;
		width: 100%;
		padding-bottom: var(--spacing-3xl);
	}

	.ort {
		font-size: var(--font-size-lg);
		opacity: 0.9;
	}

	.kopf h1 {
		margin-top: var(--spacing-xs);
		font-size: clamp(2.5rem, 6vw, 4.75rem);
		font-weight: 300;
		line-height: 1.05;
	}

	.inhalt {
		padding-top: var(--spacing-4xl);
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		gap: var(--spacing-4xl);
		align-items: start;
	}

	.zurueck {
		display: inline-block;
		margin-bottom: var(--spacing-xl);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.zurueck:hover {
		color: var(--color-text);
	}

	.beschreibung {
		font-size: var(--font-size-lg);
		font-weight: 300;
		line-height: 1.8;
		max-width: 64ch;
	}

	.beschreibung :global(p + p) {
		margin-top: var(--spacing-md);
	}

	.seite {
		position: sticky;
		top: 100px;
		background: var(--color-surface);
		padding: var(--spacing-xl);
	}

	.eckdaten div {
		display: flex;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.eckdaten div:first-child {
		padding-top: 0;
	}

	.eckdaten dt {
		color: var(--color-muted);
	}

	.eckdaten dd {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.anfrage {
		display: flex;
		width: 100%;
		margin-top: var(--spacing-xl);
	}

	.galerie-bereich {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-4xl);
	}

	.galerie-bereich h2 {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 300;
		padding-bottom: var(--spacing-lg);
		margin-bottom: var(--spacing-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.galerie {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--spacing-md);
	}

	.galerie-bild {
		aspect-ratio: 3 / 2;
		padding: 0;
		border: none;
		overflow: hidden;
		cursor: zoom-in;
		background: var(--color-surface);
	}

	.galerie-bild :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		transition: transform 700ms ease;
	}

	.galerie-bild:hover :global(img) {
		transform: scale(1.04);
	}

	.lightbox {
		margin: auto;
		padding: 0;
		border: none;
		background: transparent;
		max-width: 95vw;
		max-height: 95vh;
		cursor: zoom-out;
	}

	.lightbox::backdrop {
		background: rgb(10 10 10 / 0.92);
	}

	.lightbox img {
		max-width: 95vw;
		max-height: 90vh;
		object-fit: contain;
	}

	.schliessen {
		position: fixed;
		top: 16px;
		right: 16px;
		width: 44px;
		height: 44px;
		border: 1px solid rgb(255 255 255 / 0.4);
		background: transparent;
		color: white;
		font-size: 1.1rem;
		cursor: pointer;
	}

	.anfrage-bereich {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-5xl);
		border-top: 1px solid var(--color-border);
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
		gap: var(--spacing-4xl);
	}

	.anfrage-text h2 {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 300;
	}

	.anfrage-text p {
		margin-top: var(--spacing-md);
		color: var(--color-muted);
		max-width: 36ch;
	}

	@media (max-width: 860px) {
		.anfrage-bereich {
			grid-template-columns: 1fr;
			gap: var(--spacing-xl);
		}

		.kopf {
			min-height: 60vh;
		}

		.inhalt {
			grid-template-columns: 1fr;
			gap: var(--spacing-2xl);
		}

		.seite {
			position: static;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.galerie-bild :global(img) {
			transition: none;
		}
	}
</style>
