---
// Detailseite für ein Haus: Titelbild, Eckdaten, Beschreibung und Bildergalerie.
import { getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: haus, cacheHint } = await getEmDashEntry("hauser", slug);
if (!haus) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(haus, {
	siteUrl: Astro.url.origin,
	path: `/haeuser/${slug}`,
});

const d = haus.data as any;
const zahl = new Intl.NumberFormat("de-CH");
const galerie: any[] = Array.isArray(d.galerie) ? d.galerie.filter((row: any) => row?.bild) : [];

const eckdaten = [
	d.ort && { label: "Ort", wert: d.ort },
	d.zimmer != null && { label: "Zimmer", wert: String(d.zimmer) },
	d.wohnflaeche != null && { label: "Wohnfläche", wert: `${zahl.format(d.wohnflaeche)} m²` },
	d.grundstueck != null && { label: "Grundstück", wert: `${zahl.format(d.grundstueck)} m²` },
].filter(Boolean) as { label: string; wert: string }[];
---

<Base
	title={seo.title || d.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	content={{ collection: "hauser", id: d.id, slug: haus.id }}
>
	<article class="haus">
		<header class="kopf container">
			<a href="/" class="zurueck">Zurück zur Übersicht</a>
			<h1 {...haus.edit.title}>{d.title}</h1>
			{d.ort && <p class="ort" {...haus.edit.ort}>{d.ort}</p>}
		</header>

		{
			d.titelbild && (
				<div class="titelbild container" {...haus.edit.titelbild}>
					<Image image={d.titelbild} />
				</div>
			)
		}

		<div class="inhalt container">
			{
				eckdaten.length > 0 && (
					<dl class="eckdaten">
						{eckdaten.map((e) => (
							<div>
								<dt>{e.label}</dt>
								<dd>{e.wert}</dd>
							</div>
						))}
					</dl>
				)
			}

			<div class="beschreibung" {...haus.edit.beschreibung}>
				{d.beschreibung ? <PortableText value={d.beschreibung} /> : null}
			</div>
		</div>

		{
			galerie.length > 0 && (
				<section class="galerie-bereich container" aria-label="Bildergalerie">
					<h2>Bilder</h2>
					<div class="galerie" {...haus.edit.galerie}>
						{galerie.map((row) => (
							<button type="button" class="galerie-bild" aria-label="Bild gross anzeigen">
								<Image image={row.bild} />
							</button>
						))}
					</div>
				</section>
			)
		}
	</article>

	<dialog class="lightbox" aria-label="Bildansicht">
		<img alt="" />
		<button type="button" class="schliessen" aria-label="Schliessen">✕</button>
	</dialog>

	<script>
		const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
		const grossesBild = dialog?.querySelector("img");
		document.querySelectorAll<HTMLButtonElement>(".galerie-bild").forEach((btn) => {
			btn.addEventListener("click", () => {
				const img = btn.querySelector("img");
				if (!dialog || !grossesBild || !img) return;
				grossesBild.src = img.currentSrc || img.src;
				grossesBild.alt = img.alt;
				dialog.showModal();
			});
		});
		dialog?.addEventListener("click", () => dialog.close());
	</script>
</Base>

<style>
	.haus {
		padding-bottom: var(--spacing-5xl);
	}

	.kopf {
		padding-top: var(--spacing-2xl);
		padding-bottom: var(--spacing-2xl);
	}

	.zurueck {
		display: inline-block;
		margin-bottom: var(--spacing-2xl);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-color: var(--color-border);
	}

	.zurueck:hover {
		color: var(--color-text);
		text-decoration-color: var(--color-accent);
	}

	.kopf h1 {
		font-size: clamp(2.75rem, 7vw, 5.5rem);
		line-height: 0.98;
		letter-spacing: -0.02em;
		max-width: 16ch;
	}

	.ort {
		margin-top: var(--spacing-md);
		font-size: var(--font-size-lg);
		font-weight: 500;
		color: var(--color-brand);
	}

	.titelbild {
		aspect-ratio: 16 / 9;
	}

	.titelbild :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		max-width: none;
		border-radius: var(--radius);
	}

	.inhalt {
		margin-top: var(--spacing-3xl);
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
		gap: var(--spacing-3xl);
		align-items: start;
	}

	.eckdaten {
		border-top: 1px solid var(--color-text);
		position: sticky;
		top: 96px;
	}

	.eckdaten div {
		display: flex;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: 0.8rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.eckdaten dt {
		color: var(--color-muted);
	}

	.eckdaten dd {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.beschreibung {
		font-size: var(--font-size-lg);
		line-height: 1.75;
		max-width: 62ch;
	}

	.beschreibung :global(p + p) {
		margin-top: var(--spacing-md);
	}

	.beschreibung :global(h2),
	.beschreibung :global(h3) {
		margin: var(--spacing-xl) 0 var(--spacing-sm);
	}

	.galerie-bereich {
		margin-top: var(--spacing-4xl);
	}

	.galerie-bereich h2 {
		font-size: var(--font-size-3xl);
		margin-bottom: var(--spacing-lg);
	}

	.galerie {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-md);
	}

	.galerie-bild {
		aspect-ratio: 4 / 3;
		padding: 0;
		border: none;
		border-radius: var(--radius);
		overflow: hidden;
		cursor: zoom-in;
		background: var(--color-surface);
	}

	/* Das erste Galeriebild bekommt mehr Platz */
	.galerie-bild:first-child {
		grid-column: span 2;
		grid-row: span 2;
		aspect-ratio: auto;
	}

	.galerie-bild :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		max-width: none;
	}

	.lightbox {
		margin: auto;
		padding: 0;
		border: none;
		background: transparent;
		max-width: 95vw;
		max-height: 95vh;
		cursor: zoom-out;
	}

	.lightbox::backdrop {
		background: rgb(25 29 30 / 0.92);
	}

	.lightbox img {
		max-width: 95vw;
		max-height: 90vh;
		object-fit: contain;
	}

	.schliessen {
		position: fixed;
		top: 16px;
		right: 16px;
		width: 44px;
		height: 44px;
		border: 1px solid rgb(255 255 255 / 0.3);
		border-radius: 50%;
		background: transparent;
		color: white;
		font-size: 1.1rem;
		cursor: pointer;
	}

	@media (max-width: 860px) {
		.inhalt {
			grid-template-columns: 1fr;
			gap: var(--spacing-2xl);
		}

		.eckdaten {
			position: static;
		}

		.galerie {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
