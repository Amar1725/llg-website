---
// Detailseite für ein Modell (Containerhaus): Titelbild über die ganze Breite,
// danach Beschreibung, Eckdaten, Ausstattung, Galerie und Anfrageformular.
import { getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import { Form } from "@emdash-cms/plugin-forms/ui";
import "@emdash-cms/plugin-forms/styles";
import Base from "../../layouts/Base.astro";
import { bildUrl, kurzText } from "../../lib/teilen";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: haus, cacheHint } = await getEmDashEntry("hauser", slug);
if (!haus) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(haus, {
	siteUrl: Astro.url.origin,
	path: `/modelle/${slug}`,
});

const d = haus.data as any;
const zahl = new Intl.NumberFormat("de-DE");
const eckdatenKurz = [
	d.wohnflaeche != null && `${zahl.format(d.wohnflaeche)} m² Wohnfläche`,
	d.module != null && `${d.module} Container`,
	d.zimmer != null && `${zahl.format(d.zimmer)} Zimmer`,
].filter(Boolean).join(", ");
const teilenText = [eckdatenKurz, kurzText(d.beschreibung, 150)].filter(Boolean).join(". ");
const teilenBild = bildUrl(d.titelbild, Astro.url.origin);
const galerie: any[] = Array.isArray(d.galerie) ? d.galerie.filter((row: any) => row?.bild) : [];

// "zaehlen": Zahl, die beim Einblenden von 0 hochzählt (siehe Skript unten)
const eckdaten = [
	d.wohnflaeche != null && { label: "Wohnfläche", wert: `${zahl.format(d.wohnflaeche)} m²`, zaehlen: d.wohnflaeche, einheit: " m²" },
	d.masse && { label: "Maße (L × B × H)", wert: d.masse },
	d.module != null && { label: "Container", wert: String(d.module), zaehlen: d.module },
	d.zimmer != null && { label: "Zimmer", wert: zahl.format(d.zimmer), zaehlen: d.zimmer },
	d.baeder != null && { label: "Bäder", wert: String(d.baeder), zaehlen: d.baeder },
	d.lieferzeit && { label: "Lieferzeit", wert: d.lieferzeit },
].filter(Boolean) as { label: string; wert: string; zaehlen?: number; einheit?: string }[];

// Ausstattung: eine Zeile im Admin = ein Punkt in der Liste
const ausstattung: string[] = typeof d.ausstattung === "string"
	? d.ausstattung.split("\n").map((z: string) => z.trim()).filter(Boolean)
	: [];
---

<Base
	title={seo.title || d.title}
	description={seo.description || teilenText}
	image={seo.ogImage || teilenBild}
	canonical={seo.canonical}
	content={{ collection: "hauser", id: d.id, slug: haus.id }}
	ueberBild={!!d.titelbild}
>
	<article>
		<header class:list={["kopf", { "ohne-bild": !d.titelbild }]}>
			{
				d.titelbild && (
					<div class="kopf-bild" data-titelbild style={`view-transition-name: modell-${haus.id}`} {...haus.edit.titelbild}>
						<img
							src={teilenBild}
							alt={d.titelbild.alt || d.title}
							width={d.titelbild.width}
							height={d.titelbild.height}
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
					</div>
				)
			}
			<div class="kopf-text container">
				<p class="ort" data-reveal>Containerhaus</p>
				<h1 data-reveal style="--i: 1" {...haus.edit.title}>{d.title}</h1>
			</div>
		</header>

		<div class="inhalt container">
			<div class="beschreibung" data-reveal {...haus.edit.beschreibung}>
				<a href="/#modelle" class="zurueck">Alle Modelle</a>
				{d.beschreibung ? <PortableText value={d.beschreibung} /> : null}
				{ausstattung.length > 0 && (
					<div class="ausstattung" {...haus.edit.ausstattung}>
						<h2>Ausstattung</h2>
						<ul>
							{ausstattung.map((punkt) => <li>{punkt}</li>)}
						</ul>
					</div>
				)}
			</div>

			<aside class="seite" data-reveal style="--i: 2">
				{
					eckdaten.length > 0 && (
						<dl class="eckdaten">
							{eckdaten.map((e) => (
								<div>
									<dt>{e.label}</dt>
									<dd data-zaehlen={e.zaehlen} data-einheit={e.einheit}>{e.wert}</dd>
								</div>
							))}
						</dl>
					)
				}
				<a href="#anfrage" class="btn btn-dunkel anfrage">Angebot anfragen</a>
			</aside>
		</div>

		{
			galerie.length > 0 && (
				<section class="galerie-bereich container" aria-label="Bildergalerie">
					<h2 data-zeilen>Galerie</h2>
					<div class="galerie" data-staffel {...haus.edit.galerie}>
						{galerie.map((row) => (
							<button type="button" class="galerie-bild" data-vorhang aria-label="Bild groß anzeigen">
								<Image image={row.bild} />
							</button>
						))}
					</div>
				</section>
			)
		}

		<section class="anfrage-bereich container" id="anfrage" data-haus={d.title}>
			<div class="anfrage-text">
				<h2 data-zeilen>Angebot anfragen</h2>
				<p>Erzählen Sie uns kurz, wofür Sie das Haus nutzen möchten und wohin es geliefert werden soll. Wir melden uns so schnell wie möglich mit einem Angebot.</p>
			</div>
			<div class="anfrage-formular" data-reveal style="--i: 1">
				<Form id="kontakt" />
			</div>
		</section>
	</article>

	<dialog class="lightbox" aria-label="Bildansicht">
		<div class="lb-buehne">
			<img class="lb-bild" alt="" draggable="false" />
		</div>
		<button type="button" class="schliessen" aria-label="Schließen">✕</button>
		<button type="button" class="lb-pfeil lb-zurueck" aria-label="Vorheriges Bild">
			<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15,5 8,12 15,19" /></svg>
		</button>
		<button type="button" class="lb-pfeil lb-weiter" aria-label="Nächstes Bild">
			<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9,5 16,12 9,19" /></svg>
		</button>
		<p class="lb-zaehler" aria-live="polite"></p>
	</dialog>

	<script>
		// Galerie: Bild öffnet sich aus seinem Vorschaubild heraus, in der
		// Grossansicht wischen (Handy), ziehen (Maus) oder Pfeiltasten.
		const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
		const buehne = dialog?.querySelector<HTMLElement>(".lb-buehne");
		const gross = dialog?.querySelector<HTMLImageElement>(".lb-bild");
		const zaehler = dialog?.querySelector<HTMLElement>(".lb-zaehler");
		const knoepfe = Array.from(document.querySelectorAll<HTMLButtonElement>(".galerie-bild"));
		if (dialog && buehne && gross && zaehler && knoepfe.length) {
			const reduziert = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const kurve = "cubic-bezier(0.22, 1, 0.36, 1)";
			const mehrere = knoepfe.length > 1;
			dialog.classList.toggle("lb-mehrere", mehrere);
			let aktuell = 0;
			let beschaeftigt = false;

			const vorschau = (i: number) => knoepfe[i].querySelector("img");
			const setzen = (i: number) => {
				aktuell = (i + knoepfe.length) % knoepfe.length;
				const img = vorschau(aktuell);
				if (!img) return;
				gross.src = img.currentSrc || img.src;
				gross.alt = img.alt;
				zaehler.textContent = `${aktuell + 1} / ${knoepfe.length}`;
			};

			// Verschiebung + Skalierung vom Vorschaubild zur Grossansicht
			const vonVorschau = () => {
				const a = knoepfe[aktuell].getBoundingClientRect();
				const z = gross.getBoundingClientRect();
				if (!z.width || !a.width) return "scale(0.9)";
				const dx = a.left + a.width / 2 - (z.left + z.width / 2);
				const dy = a.top + a.height / 2 - (z.top + z.height / 2);
				return `translate(${dx}px, ${dy}px) scale(${a.width / z.width}, ${a.height / z.height})`;
			};

			const oeffnen = async (i: number) => {
				setzen(i);
				dialog.showModal();
				try {
					await gross.decode();
				} catch {}
				dialog.classList.add("offen");
				if (reduziert) return;
				knoepfe[aktuell].style.visibility = "hidden";
				const anim = gross.animate({ transform: [vonVorschau(), "none"] }, { duration: 650, easing: kurve });
				anim.onfinish = () => (knoepfe[aktuell].style.visibility = "");
			};

			const schliessen = () => {
				if (!dialog.open || beschaeftigt) return;
				dialog.classList.remove("offen");
				if (reduziert) return dialog.close();
				beschaeftigt = true;
				const knopf = knoepfe[aktuell];
				const r = knopf.getBoundingClientRect();
				const sichtbar = r.bottom > 0 && r.top < window.innerHeight;
				const ziel = sichtbar ? vonVorschau() : "scale(0.85)";
				const anim = gross.animate(
					{ transform: ["none", ziel], opacity: sichtbar ? [1, 1] : [1, 0] },
					{ duration: 500, easing: kurve, fill: "forwards" },
				);
				if (sichtbar) knopf.style.visibility = "hidden";
				anim.onfinish = () => {
					knopf.style.visibility = "";
					dialog.close();
					anim.cancel();
					beschaeftigt = false;
				};
			};

			// Zum nächsten/vorherigen Bild gleiten (richtung: 1 = weiter, -1 = zurück)
			const wechseln = async (richtung: number, schonVerschoben = 0) => {
				if (!mehrere || beschaeftigt) return;
				beschaeftigt = true;
				const breite = window.innerWidth;
				if (!reduziert) {
					await gross.animate(
						{ transform: [`translateX(${schonVerschoben}px)`, `translateX(${-richtung * breite * 0.6}px)`], opacity: [1, 0] },
						{ duration: 280, easing: "ease-in", fill: "forwards" },
					).finished;
				}
				setzen(aktuell + richtung);
				try {
					await gross.decode();
				} catch {}
				gross.getAnimations().forEach((a) => a.cancel());
				if (!reduziert) {
					await gross.animate(
						{ transform: [`translateX(${richtung * breite * 0.6}px)`, "none"], opacity: [0, 1] },
						{ duration: 450, easing: kurve },
					).finished;
				}
				beschaeftigt = false;
			};

			knoepfe.forEach((knopf, i) => knopf.addEventListener("click", () => oeffnen(i)));
			dialog.querySelector(".schliessen")?.addEventListener("click", (e) => {
				e.stopPropagation();
				schliessen();
			});
			dialog.querySelector(".lb-zurueck")?.addEventListener("click", (e) => {
				e.stopPropagation();
				wechseln(-1);
			});
			dialog.querySelector(".lb-weiter")?.addEventListener("click", (e) => {
				e.stopPropagation();
				wechseln(1);
			});
			// Esc: mit Animation schliessen statt sofort
			dialog.addEventListener("cancel", (e) => {
				e.preventDefault();
				schliessen();
			});
			dialog.addEventListener("keydown", (e) => {
				if (e.key === "ArrowRight") wechseln(1);
				if (e.key === "ArrowLeft") wechseln(-1);
			});

			// Wischen / Ziehen
			let startX = 0;
			let dx = 0;
			let zieht = false;
			buehne.addEventListener("pointerdown", (e) => {
				if (!mehrere || beschaeftigt) return;
				zieht = true;
				startX = e.clientX;
				dx = 0;
				buehne.setPointerCapture(e.pointerId);
			});
			buehne.addEventListener("pointermove", (e) => {
				if (!zieht) return;
				dx = e.clientX - startX;
				gross.style.transform = `translateX(${dx}px)`;
			});
			const loslassen = () => {
				if (!zieht) return;
				zieht = false;
				const verschoben = dx;
				gross.style.transform = "";
				if (Math.abs(verschoben) > 70) {
					wechseln(verschoben < 0 ? 1 : -1, verschoben);
				} else if (Math.abs(verschoben) > 3) {
					gross.animate({ transform: [`translateX(${verschoben}px)`, "none"] }, { duration: 350, easing: kurve });
				}
			};
			buehne.addEventListener("pointerup", loslassen);
			buehne.addEventListener("pointercancel", loslassen);

			// Klick (ohne Ziehen) neben das Bild schliesst
			dialog.addEventListener("click", (e) => {
				if (Math.abs(dx) > 3) {
					dx = 0;
					return;
				}
				if (e.target === gross && mehrere) return;
				schliessen();
			});
		}

		// Eckdaten zählen beim ersten Einblenden von 0 auf ihren Wert hoch
		if (document.documentElement.classList.contains("bewegt")) {
			const zahlFormat = new Intl.NumberFormat("de-DE", { maximumFractionDigits: 1 });
			const felder = Array.from(document.querySelectorAll<HTMLElement>("[data-zaehlen]")).filter(
				(el) => Number.isFinite(Number(el.dataset.zaehlen)) && Number(el.dataset.zaehlen) > 0,
			);
			const anzeigen = (el: HTMLElement, wert: number) => {
				const ziel = Number(el.dataset.zaehlen);
				const dezimal = !Number.isInteger(ziel);
				const zahl = dezimal ? Math.round(wert * 10) / 10 : Math.round(wert);
				el.textContent = zahlFormat.format(zahl) + (el.dataset.einheit ?? "");
			};
			felder.forEach((el) => anzeigen(el, 0));
			const zaehlen = (el: HTMLElement, verzoegerung: number) => {
				const ziel = Number(el.dataset.zaehlen);
				// grössere Zahlen dürfen etwas länger laufen
				const dauer = Math.min(1800, 900 + ziel * 6);
				let start = 0;
				const schritt = (t: number) => {
					if (!start) start = t;
					const f = Math.min(1, (t - start) / dauer);
					const weich = 1 - Math.pow(1 - f, 4);
					anzeigen(el, ziel * weich);
					if (f < 1) requestAnimationFrame(schritt);
				};
				setTimeout(() => requestAnimationFrame(schritt), verzoegerung);
			};
			const beobachter = new IntersectionObserver(
				(eintraege) => {
					if (!eintraege.some((e) => e.isIntersecting)) return;
					beobachter.disconnect();
					felder.forEach((el, i) => zaehlen(el, 350 + i * 120));
				},
				{ threshold: 0.3 },
			);
			const box = document.querySelector(".eckdaten");
			if (box && felder.length) beobachter.observe(box);
		}

		// Modellname automatisch ins Feld "haus" (Modell) des Formulars schreiben
		const bereich = document.querySelector<HTMLElement>("#anfrage");
		const hausFeld = bereich?.querySelector<HTMLInputElement>('[name="haus"]');
		if (bereich && hausFeld && !hausFeld.value) hausFeld.value = bereich.dataset.haus ?? "";
	</script>
</Base>

<style>
	.kopf {
		position: relative;
		min-height: 78vh;
		display: flex;
		align-items: flex-end;
		color: #ffffff;
		background: #1c1d1e;
		overflow: hidden;
	}

	.kopf.ohne-bild {
		min-height: 40vh;
		color: var(--color-text);
		background: var(--color-surface);
	}

	.kopf-bild {
		position: absolute;
		inset: 0;
	}

	.kopf-bild :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
	}

	.kopf-bild::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.05) 55%);
		pointer-events: none;
	}

	.kopf-text {
		position: relative;
		width: 100%;
		padding-bottom: var(--spacing-3xl);
	}

	.ort {
		font-size: var(--font-size-lg);
		opacity: 0.9;
	}

	.kopf h1 {
		margin-top: var(--spacing-xs);
		font-size: clamp(2.5rem, 6vw, 4.75rem);
		font-weight: 300;
		line-height: 1.05;
	}

	.inhalt {
		padding-top: var(--spacing-4xl);
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		gap: var(--spacing-4xl);
		align-items: start;
	}

	.zurueck {
		display: inline-block;
		margin-bottom: var(--spacing-xl);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.zurueck:hover {
		color: var(--color-text);
	}

	.beschreibung {
		font-size: var(--font-size-lg);
		font-weight: 300;
		line-height: 1.8;
		max-width: 64ch;
	}

	.beschreibung :global(p + p) {
		margin-top: var(--spacing-md);
	}

	.ausstattung {
		margin-top: var(--spacing-2xl);
	}

	.ausstattung h2 {
		font-size: var(--font-size-xl);
		font-weight: 400;
		margin-bottom: var(--spacing-md);
	}

	.ausstattung ul {
		list-style: none;
		border-top: 1px solid var(--color-border);
	}

	.ausstattung li {
		padding: 0.6rem 0 0.6rem 1.5rem;
		border-bottom: 1px solid var(--color-border);
		position: relative;
		font-size: var(--font-size-base);
	}

	.ausstattung li::before {
		content: "";
		position: absolute;
		left: 0.2rem;
		top: 1.15rem;
		width: 0.55rem;
		height: 1px;
		background: var(--color-text);
	}

	.seite {
		position: sticky;
		top: 100px;
		background: var(--color-surface);
		padding: var(--spacing-xl);
	}

	.eckdaten div {
		display: flex;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.eckdaten div:first-child {
		padding-top: 0;
	}

	.eckdaten dt {
		color: var(--color-muted);
	}

	.eckdaten dd {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.anfrage {
		display: flex;
		width: 100%;
		margin-top: var(--spacing-xl);
	}

	.galerie-bereich {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-4xl);
	}

	.galerie-bereich h2 {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 300;
		padding-bottom: var(--spacing-lg);
		margin-bottom: var(--spacing-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.galerie {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--spacing-md);
	}

	.galerie-bild {
		aspect-ratio: 3 / 2;
		padding: 0;
		border: none;
		overflow: hidden;
		cursor: zoom-in;
		background: var(--color-surface);
	}

	.galerie-bild :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		transition: transform 700ms ease;
	}

	.galerie-bild:hover :global(img) {
		transform: scale(1.04);
	}

	/* Grossansicht der Galerie: Vollbild, Hintergrund blendet weich ein */
	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: none;
		background: transparent;
		overflow: hidden;
		cursor: zoom-out;
	}

	.lightbox::backdrop {
		background: rgb(10 10 10 / 0.94);
		opacity: 0;
		transition: opacity 450ms ease;
	}

	.lightbox.offen::backdrop {
		opacity: 1;
	}

	.lb-buehne {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 4.5rem 1rem;
		touch-action: pan-y;
	}

	.lightbox.lb-mehrere .lb-buehne {
		cursor: grab;
	}

	.lb-bild {
		max-width: min(1400px, 100%);
		max-height: 100%;
		object-fit: contain;
		user-select: none;
		-webkit-user-drag: none;
		will-change: transform;
	}

	.schliessen,
	.lb-pfeil,
	.lb-zaehler {
		opacity: 0;
		transition: opacity 400ms ease 150ms, background-color 250ms ease, color 250ms ease;
	}

	.lightbox.offen .schliessen,
	.lightbox.offen .lb-pfeil,
	.lightbox.offen .lb-zaehler {
		opacity: 1;
	}

	.schliessen {
		position: fixed;
		top: 16px;
		right: 16px;
		width: 44px;
		height: 44px;
		border: 1px solid rgb(255 255 255 / 0.4);
		background: transparent;
		color: white;
		font-size: 1.1rem;
		cursor: pointer;
	}

	.lb-pfeil {
		position: fixed;
		top: 50%;
		width: 52px;
		height: 52px;
		margin-top: -26px;
		display: none;
		place-items: center;
		border: 1px solid rgb(255 255 255 / 0.4);
		border-radius: 50%;
		background: transparent;
		color: #ffffff;
		cursor: pointer;
	}

	.lightbox.lb-mehrere .lb-pfeil {
		display: grid;
	}

	.lb-pfeil:hover {
		background: #ffffff;
		color: #1c1d1e;
	}

	.lb-pfeil svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
