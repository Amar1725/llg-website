---
// Startseite: grosses Titelbild (erstes Haus) mit Slogan, darunter alle
// veröffentlichten Häuser aus der Sammlung "hauser" als Bildkacheln.
import { getEmDashCollection, getSiteSettingsWithCacheHint } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { bildUrl } from "../lib/teilen";

let haeuser: any[] = [];
try {
	const result = await getEmDashCollection("hauser", {
		status: "published",
		orderBy: { created_at: "asc" },
		limit: 50,
	});
	haeuser = result.entries ?? [];
	if (Astro.cache?.enabled && result.cacheHint) Astro.cache.set(result.cacheHint);
} catch {
	haeuser = [];
}

const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);
const settings = settingsResult.data;
const titel = settings?.title || "Unsere Häuser";
const slogan = settings?.tagline || "Wohnen zwischen See und Bergen";

const zahl = new Intl.NumberFormat("de-CH");
const anzahl = haeuser.length;
const heroBild = haeuser.find((h) => h.data.titelbild)?.data.titelbild;
const teilenBild = bildUrl(heroBild, Astro.url.origin);
---

<Base title={titel} description={slogan} image={teilenBild}>
	<section class:list={["hero", { "ohne-bild": !heroBild }]}>
		{heroBild && (
			<div class="hero-bild">
				<Image image={heroBild} />
			</div>
		)}
		<div class="hero-inhalt container">
			<h1>{slogan}</h1>
			{anzahl > 0 && (
				<a href="#haeuser" class:list={["btn", heroBild ? "btn-hell" : "btn-dunkel"]}>
					Häuser ansehen
				</a>
			)}
		</div>
	</section>

	{
		anzahl === 0 ? (
			<section class="leer container">
				<h2>Noch keine Häuser veröffentlicht</h2>
				<p>Lege im Admin unter „Häuser“ ein Haus an und veröffentliche es. Es erscheint dann hier.</p>
				{Astro.locals.user && (
					<a href="/_emdash/admin" class="btn btn-dunkel">
						Admin öffnen
					</a>
				)}
			</section>
		) : (
			<section class="haeuser container" id="haeuser">
				<header class="haeuser-kopf">
					<h2>Unsere Häuser</h2>
					<p>{anzahl === 1 ? "Ein Haus" : `${anzahl} Häuser`} im Angebot</p>
				</header>
				<div class="raster">
					{haeuser.map((haus) => (
						<a href={`/haeuser/${haus.id}`} class="kachel">
							<div class="kachel-bild">
								{haus.data.titelbild ? (
									<Image image={haus.data.titelbild} />
								) : (
									<span class="platzhalter">Noch kein Titelbild</span>
								)}
							</div>
							<div class="kachel-text">
								<h3>{haus.data.title}</h3>
								<p>
									{[
										haus.data.ort,
										haus.data.zimmer != null && `${haus.data.zimmer} Zimmer`,
										haus.data.wohnflaeche != null && `${zahl.format(haus.data.wohnflaeche)} m²`,
									]
										.filter(Boolean)
										.join("  |  ")}
								</p>
							</div>
						</a>
					))}
				</div>
			</section>
		)
	}
</Base>

<style>
	.hero {
		position: relative;
		min-height: 86vh;
		display: flex;
		align-items: flex-end;
		color: #ffffff;
		background: #1c1d1e;
		overflow: hidden;
	}

	.hero.ohne-bild {
		min-height: 60vh;
		color: var(--color-text);
		background: var(--color-surface);
	}

	.hero-bild {
		position: absolute;
		inset: 0;
	}

	.hero-bild :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
	}

	/* Abdunkeln nach unten, damit der weisse Titel lesbar bleibt */
	.hero-bild::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgb(0 0 0 / 0.62), rgb(0 0 0 / 0.08) 60%);
	}

	.hero-inhalt {
		position: relative;
		width: 100%;
		padding-bottom: var(--spacing-4xl);
	}

	.hero h1 {
		font-size: clamp(2.5rem, 6vw, 5rem);
		font-weight: 300;
		line-height: 1.08;
		letter-spacing: -0.01em;
		max-width: 15ch;
		text-wrap: balance;
		margin-bottom: var(--spacing-2xl);
	}

	.haeuser {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-5xl);
	}

	.haeuser-kopf {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--spacing-lg);
		flex-wrap: wrap;
		padding-bottom: var(--spacing-lg);
		margin-bottom: var(--spacing-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.haeuser-kopf h2 {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 300;
	}

	.haeuser-kopf p {
		color: var(--color-muted);
	}

	.raster {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: var(--spacing-lg);
	}

	.kachel {
		position: relative;
		display: block;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--color-surface);
		color: #ffffff;
	}

	.kachel-bild {
		position: absolute;
		inset: 0;
	}

	.kachel-bild :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		transition: transform 700ms ease;
	}

	.kachel:hover .kachel-bild :global(img) {
		transform: scale(1.04);
	}

	.kachel-bild::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgb(0 0 0 / 0.65), transparent 50%);
	}

	.platzhalter {
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-muted);
	}

	.kachel-text {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: var(--spacing-xl);
	}

	.kachel-text h3 {
		font-size: var(--font-size-2xl);
		font-weight: 400;
	}

	.kachel-text p {
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-sm);
		opacity: 0.85;
		white-space: pre;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.leer {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-5xl);
		max-width: 60ch;
		margin-left: 0;
	}

	.leer h2 {
		font-weight: 300;
	}

	.leer p {
		margin: var(--spacing-md) 0 var(--spacing-xl);
		color: var(--color-muted);
	}

	@media (max-width: 640px) {
		.hero {
			min-height: 72vh;
		}

		.raster {
			grid-template-columns: 1fr;
		}

		.kachel {
			aspect-ratio: 4 / 4.5;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.kachel-bild :global(img) {
			transition: none;
		}
	}
</style>
