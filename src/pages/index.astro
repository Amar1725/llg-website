---
// Startseite: großes Titelbild (erstes Modell) mit Slogan, darunter alle
// veröffentlichten Modelle (Sammlung "hauser") als Bildkacheln, danach
// "So funktioniert es" und "Häufige Fragen" aus den Widget-Bereichen.
import { getEmDashCollection, getSiteSettingsWithCacheHint, getWidgetArea } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { bildUrl } from "../lib/teilen";

let haeuser: any[] = [];
try {
	const result = await getEmDashCollection("hauser", {
		status: "published",
		orderBy: { created_at: "asc" },
		limit: 50,
	});
	haeuser = result.entries ?? [];
	if (Astro.cache?.enabled && result.cacheHint) Astro.cache.set(result.cacheHint);
} catch {
	haeuser = [];
}

const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);
const settings = settingsResult.data;
const titel = settings?.title || "Containerhäuser";
const slogan = settings?.tagline || "Containerhäuser, fertig geplant und geliefert";

const zahl = new Intl.NumberFormat("de-DE");

// Bearbeitbar im Admin unter "Widgets": Bereiche "ablauf" und "faq"
async function widgets(name: string) {
	try {
		const area = await getWidgetArea(name);
		return (area?.widgets ?? []).filter((w: any) => w.type === "content");
	} catch {
		return [];
	}
}
const ablauf = await widgets("ablauf");
const fragen = await widgets("faq");
const anzahl = haeuser.length;
const heroBild = haeuser.find((h) => h.data.titelbild)?.data.titelbild;
const teilenBild = bildUrl(heroBild, Astro.url.origin);
---

<Base title={titel} description={slogan} image={teilenBild}>
	<section class:list={["hero", { "ohne-bild": !heroBild }]}>
		{heroBild && (
			<div class="hero-bild">
				{/* Sofort laden (nicht lazy), da es das erste sichtbare Bild ist */}
				<img
					src={teilenBild}
					alt={heroBild.alt || ""}
					width={heroBild.width}
					height={heroBild.height}
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
		)}
		<div class="hero-inhalt container">
			<h1>{slogan}</h1>
			{anzahl > 0 && (
				<a href="#modelle" class:list={["btn", heroBild ? "btn-hell" : "btn-dunkel"]}>
					Modelle ansehen
				</a>
			)}
		</div>
	</section>

	{
		anzahl === 0 ? (
			<section class="leer container">
				<h2>Noch keine Modelle veröffentlicht</h2>
				<p>Lege im Admin unter „Modelle“ ein Modell an und veröffentliche es. Es erscheint dann hier.</p>
				{Astro.locals.user && (
					<a href="/_emdash/admin" class="btn btn-dunkel">
						Admin öffnen
					</a>
				)}
			</section>
		) : (
			<section class="haeuser container" id="modelle">
				<header class="haeuser-kopf">
					<h2>Unsere Modelle</h2>
					<p>{anzahl === 1 ? "Ein Modell" : `${anzahl} Modelle`}, Grundriss und Ausstattung anpassbar</p>
				</header>
				<div class="raster">
					{haeuser.map((haus) => (
						<a href={`/modelle/${haus.id}`} class="kachel">
							<div class="kachel-bild">
								{haus.data.titelbild ? (
									<Image image={haus.data.titelbild} />
								) : (
									<span class="platzhalter">Noch kein Titelbild</span>
								)}
							</div>
							<div class="kachel-text">
								<h3>{haus.data.title}</h3>
								<p>
									{[
										haus.data.wohnflaeche != null && `${zahl.format(haus.data.wohnflaeche)} m²`,
										haus.data.module != null && `${haus.data.module} Container`,
										haus.data.zimmer != null && `${zahl.format(haus.data.zimmer)} Zimmer`,
									]
										.filter(Boolean)
										.join("  |  ")}
								</p>
							</div>
						</a>
					))}
				</div>
			</section>
		)
	}

	{
		ablauf.length > 0 && (
			<section class="ablauf-bereich" aria-labelledby="ablauf-titel">
				<div class="container">
					<h2 id="ablauf-titel" class="bereich-titel">So funktioniert es</h2>
					<ol class="ablauf">
						{ablauf.map((schritt: any) => (
							<li>
								<h3>{schritt.title}</h3>
								{schritt.content && <PortableText value={schritt.content} />}
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	{
		fragen.length > 0 && (
			<section class="faq-bereich container" aria-labelledby="faq-titel">
				<h2 id="faq-titel" class="bereich-titel">Häufige Fragen</h2>
				<div class="faq">
					{fragen.map((frage: any) => (
						<details>
							<summary>{frage.title}</summary>
							<div class="antwort">{frage.content && <PortableText value={frage.content} />}</div>
						</details>
					))}
				</div>
				<p class="faq-weiter">
					Ihre Frage ist nicht dabei? <a href="/kontakt">Schreiben Sie uns.</a>
				</p>
			</section>
		)
	}
</Base>

<style>
	.hero {
		position: relative;
		min-height: 92vh;
		display: flex;
		align-items: flex-end;
		color: #ffffff;
		background: var(--color-bg);
		overflow: hidden;
	}

	.hero.ohne-bild {
		min-height: 60vh;
		color: var(--color-text);
		background: var(--color-surface);
	}

	/* Bild läuft nach unten transparent in den Seitenhintergrund aus */
	.hero-bild {
		position: absolute;
		inset: 0;
		-webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
	}

	.hero-bild :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
	}

	/* Dunkle Zone hinter dem weißen Titel, damit er lesbar bleibt */
	.hero-bild::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgb(0 0 0 / 0.55) 20%, rgb(0 0 0 / 0.35) 45%, rgb(0 0 0 / 0.05) 75%);
	}

	/* Titel sitzt über der Ausblendung, nicht im hellen Bereich */
	.hero-inhalt {
		position: relative;
		width: 100%;
		padding-bottom: clamp(11rem, 34vh, 20rem);
	}

	.hero h1 {
		font-size: clamp(2.5rem, 6vw, 5rem);
		font-weight: 300;
		line-height: 1.08;
		letter-spacing: -0.01em;
		max-width: 15ch;
		text-wrap: balance;
		margin-bottom: var(--spacing-2xl);
	}

	.haeuser {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-5xl);
	}

	.haeuser-kopf {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--spacing-lg);
		flex-wrap: wrap;
		padding-bottom: var(--spacing-lg);
		margin-bottom: var(--spacing-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.haeuser-kopf h2 {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 300;
	}

	.haeuser-kopf p {
		color: var(--color-muted);
	}

	.raster {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: var(--spacing-lg);
	}

	.kachel {
		position: relative;
		display: block;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--color-surface);
		color: #ffffff;
	}

	.kachel-bild {
		position: absolute;
		inset: 0;
	}

	.kachel-bild :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		transition: transform 700ms ease;
	}

	.kachel:hover .kachel-bild :global(img) {
		transform: scale(1.04);
	}

	.kachel-bild::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgb(0 0 0 / 0.65), transparent 50%);
	}

	.platzhalter {
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-muted);
	}

	.kachel-text {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: var(--spacing-xl);
	}

	.kachel-text h3 {
		font-size: var(--font-size-2xl);
		font-weight: 400;
	}

	.kachel-text p {
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-sm);
		opacity: 0.85;
		white-space: pre;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.leer {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-5xl);
		max-width: 60ch;
		margin-left: 0;
	}

	.leer h2 {
		font-weight: 300;
	}

	.leer p {
		margin: var(--spacing-md) 0 var(--spacing-xl);
		color: var(--color-muted);
	}

	.bereich-titel {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 300;
		padding-bottom: var(--spacing-lg);
		margin-bottom: var(--spacing-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.ablauf-bereich {
		background: var(--color-surface);
		padding: var(--spacing-4xl) 0;
	}

	.ablauf {
		list-style: none;
		counter-reset: schritt;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--spacing-2xl);
	}

	.ablauf li {
		counter-increment: schritt;
	}

	/* Die Nummer zeigt die Reihenfolge der Schritte */
	.ablauf li::before {
		content: counter(schritt);
		display: block;
		font-size: 2.75rem;
		font-weight: 300;
		line-height: 1;
		margin-bottom: var(--spacing-md);
		color: var(--color-muted);
	}

	.ablauf h3 {
		font-size: var(--font-size-lg);
		font-weight: 500;
		margin-bottom: var(--spacing-sm);
	}

	.ablauf :global(p) {
		color: var(--color-muted);
		line-height: 1.7;
	}

	/* FAQ als zentrierter Block; Fragen und Antworten bleiben linksbündig lesbar */
	.faq-bereich {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-5xl);
		max-width: 860px;
		margin-left: auto;
		margin-right: auto;
	}

	.faq-bereich .bereich-titel,
	.faq-weiter {
		text-align: center;
	}

	.faq details {
		border-bottom: 1px solid var(--color-border);
	}

	.faq summary {
		cursor: pointer;
		list-style: none;
		padding: var(--spacing-lg) 2.5rem var(--spacing-lg) 0;
		font-size: var(--font-size-lg);
		position: relative;
	}

	.faq summary::-webkit-details-marker {
		display: none;
	}

	.faq summary::after {
		content: "+";
		position: absolute;
		right: 0.25rem;
		top: 50%;
		transform: translateY(-50%);
		font-size: 1.5rem;
		font-weight: 300;
		color: var(--color-muted);
	}

	.faq details[open] summary::after {
		content: "–";
	}

	.antwort {
		padding-bottom: var(--spacing-lg);
		color: var(--color-muted);
		line-height: 1.7;
		max-width: 64ch;
	}

	.faq-weiter {
		margin-top: var(--spacing-xl);
		color: var(--color-muted);
	}

	.faq-weiter a {
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 640px) {
		.hero {
			min-height: 80vh;
		}

		.raster {
			grid-template-columns: 1fr;
		}

		.kachel {
			aspect-ratio: 4 / 4.5;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.kachel-bild :global(img) {
			transition: none;
		}
	}
</style>
