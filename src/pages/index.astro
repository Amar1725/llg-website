---
// Startseite: großes Titelbild (erstes Modell) mit Slogan, darunter alle
// veröffentlichten Modelle (Sammlung "hauser") als Bildkacheln, danach
// "So funktioniert es" und "Häufige Fragen" aus den Widget-Bereichen.
import { getEmDashCollection, getSiteSettingsWithCacheHint, getWidgetArea } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { bildUrl } from "../lib/teilen";

let haeuser: any[] = [];
try {
	const result = await getEmDashCollection("hauser", {
		status: "published",
		orderBy: { created_at: "asc" },
		limit: 50,
	});
	haeuser = result.entries ?? [];
	if (Astro.cache?.enabled && result.cacheHint) Astro.cache.set(result.cacheHint);
} catch {
	haeuser = [];
}

const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);
const settings = settingsResult.data;
const titel = settings?.title || "Containerhäuser";
const slogan = settings?.tagline || "Containerhäuser, fertig geplant und geliefert";

const zahl = new Intl.NumberFormat("de-DE");

// Bearbeitbar im Admin unter "Widgets": Bereiche "ablauf" und "faq"
async function widgets(name: string) {
	try {
		const area = await getWidgetArea(name);
		return (area?.widgets ?? []).filter((w: any) => w.type === "content");
	} catch {
		return [];
	}
}
const ablauf = await widgets("ablauf");
const fragen = await widgets("faq");
const anzahl = haeuser.length;
const heroBild = haeuser.find((h) => h.data.titelbild)?.data.titelbild;
const teilenBild = bildUrl(heroBild, Astro.url.origin);

---

<Base title={titel} description={slogan} image={teilenBild} ueberBild={!!heroBild}>
	<section class:list={["hero", { "ohne-bild": !heroBild }]}>
		{heroBild && (
			<div class="hero-bild" data-titelbild data-parallax>
				{/* Sofort laden (nicht lazy), da es das erste sichtbare Bild ist */}
				<img
					src={teilenBild}
					alt={heroBild.alt || ""}
					width={heroBild.width}
					height={heroBild.height}
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
		)}
		<div class="hero-inhalt container">
			<h1 data-zeilen style="--start: 250ms">{slogan}</h1>
			{anzahl > 0 && (
				<a href="#modelle" class:list={["btn", heroBild ? "btn-hell" : "btn-dunkel"]} data-reveal style="--i: 7">
					Modelle ansehen
				</a>
			)}
		</div>
		{heroBild && anzahl > 0 && (
			<a href="#modelle" class="abzeichen" aria-label="Zu den Modellen">
				<svg class="ring" viewBox="0 0 132 132" aria-hidden="true">
					<defs>
						<path id="abzeichen-kreis" d="M66,66 m-52,0 a52,52 0 1,1 104,0 a52,52 0 1,1 -104,0" />
					</defs>
					<text>
						<textPath href="#abzeichen-kreis" textLength="324" lengthAdjust="spacing">Modelle ansehen · Modelle ansehen · </textPath>
					</text>
				</svg>
				<span class="pfeil-runter">
					<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="5,9 12,16 19,9" /></svg>
				</span>
			</a>
		)}
	</section>

	{
		anzahl === 0 ? (
			<section class="leer container">
				<h2>Noch keine Modelle veröffentlicht</h2>
				<p>Lege im Admin unter „Modelle“ ein Modell an und veröffentliche es. Es erscheint dann hier.</p>
				{Astro.locals.user && (
					<a href="/_emdash/admin" class="btn btn-dunkel">
						Admin öffnen
					</a>
				)}
			</section>
		) : (
			<section class="haeuser container" id="modelle">
				<header class="haeuser-kopf" data-linie>
					<h2 data-zeilen>Unsere Modelle</h2>
					<div class="kopf-rechts" data-reveal style="--i: 2">
						<p>{anzahl === 1 ? "Ein Modell" : `${anzahl} Modelle`}, Grundriss und Ausstattung anpassbar</p>
					</div>
				</header>
				<div class="raster" data-karussell data-staffel role="region" aria-label="Modelle" tabindex="0">
					{haeuser.map((haus) => (
						<a href={`/modelle/${haus.id}`} class="kachel" data-kachel>
							<div class="kachel-bild" style={`view-transition-name: modell-${haus.id}`}>
								{haus.data.titelbild ? (
									<Image image={haus.data.titelbild} />
								) : (
									<span class="platzhalter">Noch kein Titelbild</span>
								)}
							</div>
							<div class="kachel-text">
								<h3>{haus.data.title}</h3>
								<p>
									{[
										haus.data.wohnflaeche != null && `${zahl.format(haus.data.wohnflaeche)} m²`,
										haus.data.module != null && `${haus.data.module} Container`,
										haus.data.zimmer != null && `${zahl.format(haus.data.zimmer)} Zimmer`,
									]
										.filter(Boolean)
										.join("  |  ")}
								</p>
							</div>
						</a>
					))}
				</div>
			</section>
		)
	}

	{
		ablauf.length > 0 && (
			<section class="ablauf-bereich" id="ablauf" aria-labelledby="ablauf-titel">
				<div class="container">
					<h2 id="ablauf-titel" class="bereich-titel" data-zeilen data-linie>So funktioniert es</h2>
					<ol class="ablauf" data-staffel data-zeitstrahl style={`--n: ${ablauf.length}`}>
						{ablauf.map((schritt: any) => (
							<li data-reveal>
								<h3>{schritt.title}</h3>
								{schritt.content && <PortableText value={schritt.content} />}
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	{
		fragen.length > 0 && (
			<section class="faq-bereich container" id="fragen" aria-labelledby="faq-titel">
				<h2 id="faq-titel" class="bereich-titel" data-zeilen data-linie>Häufige Fragen</h2>
				<div class="faq" data-staffel>
					{fragen.map((frage: any) => (
						<details data-reveal>
							<summary>{frage.title}</summary>
							<div class="antwort-huelle">
									<div class="antwort">{frage.content && <PortableText value={frage.content} />}</div>
								</div>
						</details>
					))}
				</div>
				<p class="faq-weiter" data-reveal>
					Ihre Frage ist nicht dabei? <a href="/kontakt">Schreiben Sie uns.</a>
				</p>
			</section>
		)
	}
</Base>

<style>
	.hero {
		position: relative;
		min-height: 92vh;
		display: flex;
		align-items: flex-end;
		color: #ffffff;
		background: var(--color-bg);
		overflow: hidden;
	}

	.hero.ohne-bild {
		min-height: 60vh;
		color: var(--color-text);
		background: var(--color-surface);
	}

	/* Bild läuft nach unten transparent in den Seitenhintergrund aus */
	.hero-bild {
		position: absolute;
		inset: 0;
		-webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
	}

	.hero-bild :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
	}

	/* Dunkle Zone hinter dem weißen Titel, damit er lesbar bleibt */
	.hero-bild::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgb(0 0 0 / 0.6) 25%, rgb(0 0 0 / 0.5) 50%, rgb(0 0 0 / 0.12) 85%);
	}

	/* Titel sitzt über der Ausblendung, nicht im hellen Bereich */
	.hero-inhalt {
		position: relative;
		width: 100%;
		padding-bottom: clamp(11rem, 34vh, 20rem);
	}

	/* Weicher Schatten statt Umrandung: hebt den Titel vom Bild ab */
	.hero h1 {
		text-shadow: 0 2px 28px rgb(0 0 0 / 0.45), 0 1px 3px rgb(0 0 0 / 0.3);
		font-size: clamp(2.5rem, 6vw, 5rem);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.01em;
		max-width: 15ch;
		text-wrap: balance;
		margin-bottom: var(--spacing-2xl);
	}

	/* Mit Animation: Schatten als Filter, sonst zeichnen die beim Einblenden
	   abgeschnittenen Wörter kurz harte Schattenkanten */
	:global(.bewegt) .hero h1 {
		text-shadow: none;
		filter: drop-shadow(0 2px 18px rgb(0 0 0 / 0.45)) drop-shadow(0 1px 2px rgb(0 0 0 / 0.3));
	}

	.haeuser {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-5xl);
	}

	.haeuser-kopf {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--spacing-lg);
		flex-wrap: wrap;
		padding-bottom: var(--spacing-lg);
		margin-bottom: var(--spacing-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.haeuser-kopf h2 {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 300;
	}

	.haeuser-kopf p {
		color: var(--color-muted);
	}

	/* Modelle als Karussell: 3 nebeneinander, mit der Maus ziehen oder wischen */
	.kopf-rechts {
		display: flex;
		align-items: center;
		gap: var(--spacing-lg);
		flex-wrap: wrap;
	}

	/* Karussell geht über die ganze Bildschirmbreite; das aktive Modell steht
	   in der Mitte, links und rechts schauen die Nachbarn hervor. */
	:global(main) {
		overflow-x: clip;
	}

	.raster {
		--breite: clamp(320px, 38vw, 580px);
		display: flex;
		gap: var(--spacing-lg);
		margin-inline: calc(50% - 50vw);
		/* Rand, damit auch das erste und letzte Modell mittig stehen können
		   (genauer Wert kommt aus dem Skript) */
		padding-inline: var(--rand, calc(50vw - var(--breite) / 2));
		scroll-padding-inline: var(--rand, calc(50vw - var(--breite) / 2));
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
		overscroll-behavior-x: contain;
	}

	/* Mit der Maus ziehen (am Handy wischt man ohnehin) */
	.raster.ziehbar {
		cursor: grab;
	}

	.raster.zieht {
		cursor: grabbing;
		scroll-snap-type: none;
		scroll-behavior: auto;
		user-select: none;
	}

	.raster.zieht .kachel {
		pointer-events: none;
	}

	.raster :global(img) {
		-webkit-user-drag: none;
		user-select: none;
	}

	.raster::-webkit-scrollbar {
		display: none;
	}

	.raster:focus-visible {
		outline-offset: 6px;
	}

	.kachel {
		flex: 0 0 var(--breite);
		scroll-snap-align: center;
		position: relative;
		display: block;
		aspect-ratio: 4 / 4.4;
		overflow: hidden;
		background: var(--color-surface);
		color: #ffffff;
	}

	.kachel-bild {
		position: absolute;
		inset: 0;
	}

	.kachel-bild :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		transition: transform 700ms ease;
	}

	.kachel:hover .kachel-bild :global(img) {
		transform: scale(1.04);
	}

	.kachel-bild::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgb(0 0 0 / 0.65), transparent 50%);
	}

	.platzhalter {
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-muted);
	}

	.kachel-text {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: var(--spacing-xl);
	}

	.kachel-text h3 {
		font-size: var(--font-size-2xl);
		font-weight: 400;
	}

	/* Beim Darüberfahren erscheint ein Pfeil neben dem Namen */
	.kachel-text h3::after {
		content: "→";
		display: inline-block;
		margin-left: 0.4em;
		opacity: 0;
		transform: translateX(-10px);
		transition: opacity 400ms ease, transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.kachel:hover .kachel-text h3::after,
	.kachel:focus-visible .kachel-text h3::after {
		opacity: 1;
		transform: none;
	}

	.kachel-text p {
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-sm);
		opacity: 0.85;
		white-space: pre;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.leer {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-5xl);
		max-width: 60ch;
		margin-left: 0;
	}

	.leer h2 {
		font-weight: 300;
	}

	.leer p {
		margin: var(--spacing-md) 0 var(--spacing-xl);
		color: var(--color-muted);
	}

	.bereich-titel {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 300;
		padding-bottom: var(--spacing-lg);
		margin-bottom: var(--spacing-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.ablauf-bereich {
		background: var(--color-surface);
		padding: var(--spacing-4xl) 0;
	}

	.ablauf {
		list-style: none;
		counter-reset: schritt;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--spacing-2xl);
	}

	.ablauf li {
		counter-increment: schritt;
		position: relative;
	}

	/* --- Zeitstrahl (Skript setzt .zeitstrahl, --fortschritt und .aktiv) --- */
	.ablauf.zeitstrahl {
		position: relative;
	}

	/* Schiene und Fortschritt */
	.ablauf.zeitstrahl::before,
	.ablauf.zeitstrahl::after {
		content: "";
		position: absolute;
		left: var(--start-x, 0);
		top: var(--start-y, 0);
		background: var(--color-border);
	}

	.ablauf.zeitstrahl::after {
		background: var(--color-text);
		transition: transform 200ms linear;
	}

	/* Punkt auf der Linie für jeden Schritt */
	.ablauf.zeitstrahl li::after {
		content: "";
		position: absolute;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		border: 1.5px solid var(--color-muted);
		background: var(--color-surface);
		transition:
			background-color 400ms ease,
			border-color 400ms ease,
			transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.ablauf.zeitstrahl li.aktiv::after {
		background: var(--color-text);
		border-color: var(--color-text);
		transform: scale(1.25);
	}

	.ablauf.zeitstrahl li::before {
		transition: color 500ms ease;
	}

	.ablauf.zeitstrahl li.aktiv::before {
		color: var(--color-text);
	}

	/* Breit: Schritte nebeneinander, Linie waagrecht über den Nummern */
	@media (min-width: 901px) {
		.ablauf.zeitstrahl {
			grid-template-columns: repeat(var(--n, 4), 1fr);
		}

		.ablauf.zeitstrahl li {
			padding-top: 2.75rem;
		}

		.ablauf.zeitstrahl li::after {
			left: 0;
			top: 0;
		}

		.ablauf.zeitstrahl::before,
		.ablauf.zeitstrahl::after {
			width: var(--laenge, 0);
			height: 1.5px;
			margin-top: 5.75px;
			margin-left: 6px;
		}

		.ablauf.zeitstrahl::after {
			transform-origin: left center;
			transform: scaleX(var(--fortschritt, 0));
		}
	}

	/* Schmal: Schritte untereinander, Linie senkrecht links */
	@media (max-width: 900px) {
		.ablauf.zeitstrahl {
			grid-template-columns: 1fr;
			padding-left: 2.75rem;
		}

		.ablauf.zeitstrahl li::after {
			left: -2.75rem;
			top: 1rem;
		}

		.ablauf.zeitstrahl::before,
		.ablauf.zeitstrahl::after {
			width: 1.5px;
			height: var(--laenge, 0);
			margin-left: 5.75px;
			margin-top: 6px;
		}

		.ablauf.zeitstrahl::after {
			transform-origin: center top;
			transform: scaleY(var(--fortschritt, 0));
		}
	}

	/* Die Nummer zeigt die Reihenfolge der Schritte */
	.ablauf li::before {
		content: counter(schritt);
		display: block;
		font-size: 2.75rem;
		font-weight: 300;
		line-height: 1;
		margin-bottom: var(--spacing-md);
		color: var(--color-muted);
	}

	.ablauf h3 {
		font-size: var(--font-size-lg);
		font-weight: 500;
		margin-bottom: var(--spacing-sm);
	}

	.ablauf :global(p) {
		color: var(--color-muted);
		line-height: 1.7;
	}

	/* FAQ als zentrierter Block; Fragen und Antworten bleiben linksbündig lesbar */
	.faq-bereich {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-5xl);
		max-width: 860px;
		margin-left: auto;
		margin-right: auto;
	}

	.faq-bereich .bereich-titel,
	.faq-weiter {
		text-align: center;
	}

	.faq details {
		border-bottom: 1px solid var(--color-border);
	}

	.faq summary {
		cursor: pointer;
		list-style: none;
		padding: var(--spacing-lg) 2.5rem var(--spacing-lg) 0;
		font-size: var(--font-size-lg);
		position: relative;
		transition: padding-left 400ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.faq summary:hover {
		padding-left: 0.5rem;
	}

	.faq summary::-webkit-details-marker {
		display: none;
	}

	/* Plus aus zwei Strichen: beim Öffnen dreht sich der senkrechte Strich
	   flach, aus dem Plus wird ein Minus */
	.faq summary::before,
	.faq summary::after {
		content: "";
		position: absolute;
		right: 0.35rem;
		top: 50%;
		width: 16px;
		height: 1.5px;
		margin-top: -0.75px;
		background: var(--color-text);
		transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.faq summary::after {
		transform: rotate(90deg);
	}

	.faq details.offen summary::after {
		transform: rotate(180deg);
	}

	.faq details.offen summary::before {
		transform: rotate(180deg);
	}

	/* Hülle für die Aufklapp-Animation (Höhe wird vom Skript animiert) */
	.antwort-huelle {
		overflow: hidden;
	}

	.antwort {
		padding-bottom: var(--spacing-lg);
		color: var(--color-muted);
		line-height: 1.7;
		max-width: 64ch;
	}

	.faq-weiter {
		margin-top: var(--spacing-xl);
		color: var(--color-muted);
	}

	.faq-weiter a {
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 640px) {
		.hero {
			min-height: 80vh;
		}

		/* Handy: ein Modell in der Mitte, die Nachbarn schauen am Rand hervor */
		.raster {
			--breite: 76vw;
			gap: var(--spacing-md);
		}

		.kachel {
			aspect-ratio: 4 / 4.8;
		}
	}

	@media (min-width: 641px) and (max-width: 1000px) {
		.raster {
			--breite: 44vw;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.raster {
			scroll-behavior: auto;
		}

		.kachel-bild :global(img) {
			transition: none;
		}
	}
</style>

<script>
	// Karussell der Modelle: am Handy wischen, am PC mit der Maus ziehen
	// (mit Schwung und Einrasten auf das nächste Modell) oder mit dem Trackpad.
	function karussellStarten() {
		const raster = document.querySelector<HTMLElement>("[data-karussell]");
		if (!raster) return;
		const reduziert = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		const kannBlaettern = () => raster.scrollWidth - raster.clientWidth > 2;
		const schritt = () => {
			const kachel = raster.querySelector<HTMLElement>(".kachel");
			const abstand = parseFloat(getComputedStyle(raster).columnGap || "0") || 0;
			return kachel ? kachel.getBoundingClientRect().width + abstand : raster.clientWidth;
		};
		// Rand so setzen, dass ein Modell genau in der Mitte steht
		const randSetzen = () => {
			const kachel = raster.querySelector<HTMLElement>(".kachel");
			if (!kachel) return;
			const rand = Math.max(0, (raster.clientWidth - kachel.getBoundingClientRect().width) / 2);
			raster.style.setProperty("--rand", `${rand}px`);
		};
		const aktualisieren = () => {
			randSetzen();
			raster.classList.toggle("ziehbar", kannBlaettern());
		};

		let zieht = false;
		let verschoben = false;
		let startX = 0;
		let startScroll = 0;
		let letzteX = 0;
		let letzteZeit = 0;
		let tempo = 0;
		let schwung = 0;

		const einrasten = () => {
			raster.classList.remove("zieht");
			const max = raster.scrollWidth - raster.clientWidth;
			const s = schritt();
			const ziel = Math.min(max, Math.max(0, Math.round(raster.scrollLeft / s) * s));
			raster.scrollTo({ left: ziel, behavior: reduziert ? "auto" : "smooth" });
		};

		raster.addEventListener("pointerdown", (e) => {
			if (e.pointerType !== "mouse" || e.button !== 0 || !kannBlaettern()) return;
			cancelAnimationFrame(schwung);
			zieht = true;
			verschoben = false;
			startX = letzteX = e.clientX;
			startScroll = raster.scrollLeft;
			letzteZeit = performance.now();
			tempo = 0;
		});

		window.addEventListener("pointermove", (e) => {
			if (!zieht) return;
			const dx = e.clientX - startX;
			if (!verschoben && Math.abs(dx) > 5) {
				verschoben = true;
				raster.classList.add("zieht");
			}
			if (!verschoben) return;
			raster.scrollLeft = startScroll - dx;
			const jetzt = performance.now();
			const dt = jetzt - letzteZeit;
			if (dt > 0) tempo = 0.8 * ((e.clientX - letzteX) / dt) + 0.2 * tempo;
			letzteX = e.clientX;
			letzteZeit = jetzt;
		});

		window.addEventListener("pointerup", () => {
			if (!zieht) return;
			zieht = false;
			if (!verschoben) return;
			// Schwung auslaufen lassen, dann auf das nächste Modell einrasten
			let v = reduziert ? 0 : -tempo * 16;
			const gleiten = () => {
				v *= 0.92;
				raster.scrollLeft += v;
				if (Math.abs(v) > 0.6) schwung = requestAnimationFrame(gleiten);
				else einrasten();
			};
			gleiten();
		});

		// Nach dem Ziehen nicht versehentlich ein Modell öffnen
		raster.addEventListener(
			"click",
			(e) => {
				if (verschoben) {
					e.preventDefault();
					e.stopPropagation();
					verschoben = false;
				}
			},
			true,
		);
		raster.addEventListener("dragstart", (e) => e.preventDefault());

		window.addEventListener("resize", aktualisieren);
		aktualisieren();

		// Ab drei Modellen mit dem zweiten in der Mitte starten, damit links und
		// rechts je ein Nachbar hervorschaut
		if (raster.querySelectorAll(".kachel").length >= 3) {
			raster.scrollTo({ left: schritt(), behavior: "instant" as ScrollBehavior });
		}
	}

	karussellStarten();

	// Häufige Fragen: Antworten weich auf- und zuklappen statt springen.
	function faqStarten() {
		const reduziert = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const kurve = "cubic-bezier(0.22, 1, 0.36, 1)";

		document.querySelectorAll<HTMLDetailsElement>(".faq details").forEach((frage) => {
			const kopf = frage.querySelector("summary");
			const huelle = frage.querySelector<HTMLElement>(".antwort-huelle");
			const antwort = frage.querySelector<HTMLElement>(".antwort");
			if (!kopf || !huelle || !antwort) return;
			let laeuft: Animation | null = null;
			frage.classList.toggle("offen", frage.open);

			kopf.addEventListener("click", (e) => {
				if (reduziert) {
					// Ohne Animation: nur das Symbol mitschalten
					requestAnimationFrame(() => frage.classList.toggle("offen", frage.open));
					return;
				}
				e.preventDefault();
				laeuft?.cancel();

				if (!frage.open || laeuft?.id === "zu") {
					// Öffnen
					frage.open = true;
					frage.classList.add("offen");
					const ziel = huelle.scrollHeight;
					laeuft = huelle.animate({ height: [`${huelle.offsetHeight}px`, `${ziel}px`] }, { duration: 550, easing: kurve });
					laeuft.id = "auf";
					antwort.animate(
						{ opacity: [0, 1], transform: ["translateY(-10px)", "none"] },
						{ duration: 500, delay: 120, easing: kurve, fill: "backwards" },
					);
					laeuft.onfinish = () => (laeuft = null);
				} else {
					// Schliessen
					frage.classList.remove("offen");
					laeuft = huelle.animate({ height: [`${huelle.offsetHeight}px`, "0px"] }, { duration: 420, easing: kurve });
					laeuft.id = "zu";
					antwort.animate({ opacity: [1, 0] }, { duration: 250, easing: "ease" });
					laeuft.onfinish = () => {
						frage.open = false;
						laeuft = null;
					};
				}
			});
		});
	}

	faqStarten();

	// "So funktioniert es" als Zeitstrahl: die Linie zeichnet sich beim
	// Scrollen von Schritt zu Schritt, erreichte Schritte werden hervorgehoben.
	function zeitstrahlStarten() {
		const liste = document.querySelector<HTMLElement>("[data-zeitstrahl]");
		if (!liste) return;
		const schritte = Array.from(liste.querySelectorAll<HTMLElement>(":scope > li"));
		if (schritte.length < 2) return;
		liste.classList.add("zeitstrahl");
		const reduziert = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const waagrecht = () => window.matchMedia("(min-width: 901px)").matches;
		let geplant = false;

		// Länge der Linie: vom ersten bis zum letzten Punkt
		const vermessen = () => {
			const a = schritte[0].getBoundingClientRect();
			const z = schritte[schritte.length - 1].getBoundingClientRect();
			const laenge = waagrecht() ? z.left - a.left : z.top - a.top;
			liste.style.setProperty("--laenge", `${laenge}px`);
			liste.style.setProperty("--start-x", waagrecht() ? "0px" : "0px");
			liste.style.setProperty("--start-y", waagrecht() ? "0px" : "1rem");
		};

		const zeichnen = () => {
			geplant = false;
			const r = liste.getBoundingClientRect();
			const vh = window.innerHeight;
			let p: number;
			if (reduziert) {
				p = 1;
			} else if (waagrecht()) {
				// Beginnt, wenn die Liste bei 85 % der Fensterhöhe ist, fertig bei 30 %
				p = (vh * 0.85 - r.top) / (vh * 0.55);
			} else {
				// Senkrecht: die Linie folgt der Fenstermitte
				const a = schritte[0].getBoundingClientRect().top;
				const z = schritte[schritte.length - 1].getBoundingClientRect().top;
				p = (vh * 0.6 - a) / Math.max(1, z - a);
			}
			p = Math.min(1, Math.max(0, p));
			liste.style.setProperty("--fortschritt", p.toFixed(4));
			schritte.forEach((li, i) => li.classList.toggle("aktiv", p >= i / (schritte.length - 1) - 0.001 && p > 0));
		};

		const planen = () => {
			if (geplant) return;
			geplant = true;
			requestAnimationFrame(zeichnen);
		};

		vermessen();
		zeichnen();
		window.addEventListener("scroll", planen, { passive: true });
		window.addEventListener("resize", () => {
			vermessen();
			planen();
		});
	}

	zeitstrahlStarten();
</script>
