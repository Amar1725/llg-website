---
// Startseite: stellt alle veröffentlichten Häuser aus der Sammlung "hauser" vor.
// Jedes Haus bekommt eine grosse Bildzeile, abwechselnd links und rechts.
import { getEmDashCollection, getSiteSettingsWithCacheHint } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";

let haeuser: any[] = [];
try {
	const result = await getEmDashCollection("hauser", {
		status: "published",
		orderBy: { created_at: "asc" },
		limit: 50,
	});
	haeuser = result.entries ?? [];
	if (Astro.cache?.enabled && result.cacheHint) Astro.cache.set(result.cacheHint);
} catch {
	haeuser = [];
}

const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);
const settings = settingsResult.data;
const titel = settings?.title || "Unsere Häuser";
const slogan = settings?.tagline || "Wohnen zwischen See und Bergen";

const zahl = new Intl.NumberFormat("de-CH");
const anzahl = haeuser.length;
---

<Base title={titel}>
	<section class="intro container">
		<h1>{slogan}</h1>
		<div class="intro-text">
			{anzahl > 0 && (
				<p class="anzahl">
					{anzahl === 1 ? "Ein Haus" : `${anzahl} Häuser`} im Angebot
				</p>
			)}
		</div>
	</section>

	{
		anzahl === 0 ? (
			<section class="leer container">
				<h2>Noch keine Häuser veröffentlicht</h2>
				<p>Lege im Admin unter „Häuser“ ein Haus an und veröffentliche es. Es erscheint dann hier.</p>
				{Astro.locals.user && (
					<a href="/_emdash/admin" class="btn btn-primary">
						Admin öffnen
					</a>
				)}
			</section>
		) : (
			<section class="liste container" aria-label="Häuser">
				{haeuser.map((haus, i) => (
					<article class:list={["haus", { gespiegelt: i % 2 === 1 }]}>
						<a href={`/haeuser/${haus.id}`} class="haus-bild" tabindex="-1" aria-hidden="true">
							{haus.data.titelbild ? (
								<Image image={haus.data.titelbild} />
							) : (
								<span class="platzhalter">Noch kein Titelbild</span>
							)}
						</a>
						<div class="haus-text">
							{haus.data.ort && <p class="ort">{haus.data.ort}</p>}
							<h2>
								<a href={`/haeuser/${haus.id}`}>{haus.data.title}</a>
							</h2>
							<dl class="eckdaten">
								{haus.data.zimmer != null && (
									<div>
										<dt>Zimmer</dt>
										<dd>{haus.data.zimmer}</dd>
									</div>
								)}
								{haus.data.wohnflaeche != null && (
									<div>
										<dt>Wohnfläche</dt>
										<dd>{zahl.format(haus.data.wohnflaeche)} m²</dd>
									</div>
								)}
								{haus.data.grundstueck != null && (
									<div>
										<dt>Grundstück</dt>
										<dd>{zahl.format(haus.data.grundstueck)} m²</dd>
									</div>
								)}
							</dl>
							<a href={`/haeuser/${haus.id}`} class="haus-link">
								Haus ansehen
							</a>
						</div>
					</article>
				))}
			</section>
		)
	}
</Base>

<style>
	.intro {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-3xl);
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		gap: var(--spacing-2xl);
		align-items: end;
	}

	.intro h1 {
		font-size: clamp(2.75rem, 6.5vw, 5.75rem);
		line-height: 1;
		letter-spacing: -0.02em;
		max-width: 14ch;
		text-wrap: balance;
	}

	.intro-text {
		padding-bottom: 0.6rem;
		border-left: 1px solid var(--color-border);
		padding-left: var(--spacing-lg);
	}

	.anzahl {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.liste {
		padding-bottom: var(--spacing-5xl);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5xl);
	}

	.haus {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		gap: var(--spacing-3xl);
		align-items: center;
	}

	.haus.gespiegelt {
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
	}

	.haus.gespiegelt .haus-bild {
		order: 2;
	}

	.haus-bild {
		display: block;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.haus-bild :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		max-width: none;
		transition: transform 600ms ease;
	}

	.haus:hover .haus-bild :global(img) {
		transform: scale(1.025);
	}

	.platzhalter {
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-muted);
	}

	.ort {
		color: var(--color-brand);
		font-weight: 500;
	}

	.haus-text h2 {
		margin-top: var(--spacing-xs);
		font-size: clamp(2rem, 3.6vw, 3rem);
		line-height: 1.05;
	}

	.haus-text h2 a:hover {
		color: var(--color-brand);
	}

	.eckdaten {
		margin-top: var(--spacing-xl);
		border-top: 1px solid var(--color-border);
	}

	.eckdaten div {
		display: flex;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: 0.7rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.eckdaten dt {
		color: var(--color-muted);
	}

	.eckdaten dd {
		font-variant-numeric: tabular-nums;
	}

	.haus-link {
		display: inline-block;
		margin-top: var(--spacing-xl);
		font-weight: 600;
		color: var(--color-brand);
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
	}

	.haus-link:hover {
		text-decoration-color: var(--color-brand);
	}

	.leer {
		padding-top: var(--spacing-2xl);
		padding-bottom: var(--spacing-5xl);
		max-width: 60ch;
		margin-left: 0;
	}

	.leer h2 {
		font-size: var(--font-size-3xl);
	}

	.leer p {
		margin: var(--spacing-md) 0 var(--spacing-xl);
		color: var(--color-muted);
	}

	@media (max-width: 860px) {
		.intro,
		.haus,
		.haus.gespiegelt {
			grid-template-columns: 1fr;
		}

		.intro {
			padding-top: var(--spacing-3xl);
			gap: var(--spacing-lg);
		}

		.haus {
			gap: var(--spacing-lg);
		}

		.haus.gespiegelt .haus-bild {
			order: 0;
		}

		.liste {
			gap: var(--spacing-4xl);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.haus-bild :global(img) {
			transition: none;
		}
	}
</style>
