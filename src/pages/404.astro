---
import Base from "../layouts/Base.astro";
---

<Base title="Seite nicht gefunden" robots="noindex">
	<section class="nicht-gefunden container">
		<p class="code">404</p>
		<h1>Diese Seite gibt es nicht</h1>
		<p>Vielleicht wurde sie verschoben, oder die Adresse ist falsch geschrieben.</p>
		<div class="aktionen">
			<a href="/" class="btn btn-dunkel">Zur Startseite</a>
			<a href="/kontakt" class="btn nicht-gefunden-sekundaer">Kontakt</a>
		</div>
	</section>
</Base>

<style>
	.nicht-gefunden {
		padding-top: var(--spacing-5xl);
		padding-bottom: var(--spacing-5xl);
		max-width: 760px;
	}

	.code {
		font-size: var(--font-size-sm);
		letter-spacing: 0.32em;
		color: var(--color-muted);
	}

	h1 {
		margin-top: var(--spacing-md);
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 300;
	}

	h1 + p {
		margin-top: var(--spacing-md);
		color: var(--color-muted);
	}

	.aktionen {
		margin-top: var(--spacing-2xl);
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-md);
	}

	.nicht-gefunden-sekundaer {
		color: var(--color-text);
		background: transparent;
		border: 1px solid var(--color-border);
	}

	.nicht-gefunden-sekundaer:hover {
		border-color: var(--color-text);
	}
</style>
