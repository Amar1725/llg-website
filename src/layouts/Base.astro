---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead, PortableText } from "emdash/ui";
import { getWidgetArea } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/animationen.css";
import "../styles/menue.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	/** Seite beginnt mit einem grossen Bild: Kopfzeile liegt dann durchsichtig darüber */
	ueberBild?: boolean;
}

const { title, pageTitle, description, canonical, robots, content, ueberBild = false } = Astro.props;
const image = Astro.props.image || new URL("/og-standard.png", Astro.url.origin).toString();
const [settingsResult, menuResult, footerProductResult, footerCompanyResult, footerSupportResult] =
	await Promise.all([
		getSiteSettingsWithCacheHint(),
		getMenuWithCacheHint("primary"),
		getMenuWithCacheHint("footer_product"),
		getMenuWithCacheHint("footer_company"),
		getMenuWithCacheHint("footer_support"),
	]);

if (Astro.cache?.enabled) {
	for (const result of [
		settingsResult,
		menuResult,
		footerProductResult,
		footerCompanyResult,
		footerSupportResult,
	]) {
		Astro.cache.set(result.cacheHint);
	}
}

const settings = settingsResult.data;
const siteTitle = settings?.title || "Modulhäuser";
const fullTitle = title ? (title.includes(siteTitle) ? title : `${title} — ${siteTitle}`) : siteTitle;
const siteDescription =
	settings?.tagline || "";
const siteLogo = settings.logo?.url ? settings.logo : null;
const menu = menuResult.data;
const footerProduct = footerProductResult.data;
const footerCompany = footerCompanyResult.data;
const footerSupport = footerSupportResult.data;

const footerColumns = [
	{ heading: "Angebot", menu: footerProduct },
	{ heading: "Über uns", menu: footerCompany },
	{ heading: "Kontakt", menu: footerSupport },
].filter((col) => col.menu && col.menu.items.length > 0);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteDescription,
	canonical: canonical ?? `${Astro.url.origin}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

// Footer-Spalten aus dem Widget-Bereich "footer" (im Admin unter Widgets bearbeitbar)
let footerWidgets: any[] = [];
try {
	const footerArea = await getWidgetArea("footer");
	footerWidgets = footerArea?.widgets ?? [];
} catch {
	footerWidgets = [];
}

const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#1c1d1e" />
		<Font cssVariable="--font-body" preload />
		<script is:inline>
			// Kontaktformular bei jedem Seitenaufruf leer starten: das Forms-Plugin
			// merkt sich Eingaben sonst im Browser und füllt sie auf anderen Seiten wieder ein.
			try {
				for (var k = sessionStorage.length - 1; k >= 0; k--) {
					var key = sessionStorage.key(k);
					if (key && key.indexOf("ec-form:") === 0) sessionStorage.removeItem(key);
				}
			} catch (e) {}
		</script>
		<script is:inline>
			// Animationen nur einschalten, wenn der Besucher keine reduzierte
			// Bewegung eingestellt hat. Falls das Animations-Skript nicht startet,
			// wird nach 3 Sekunden alles normal angezeigt.
			(function () {
				if (!window.matchMedia || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				var r = document.documentElement;
				r.classList.add("bewegt");
				// Kommt die Seite per Übergang (Modell-Bild wächst), startet sie
				// ohne eigene Einstiegs-Animation, damit nichts doppelt läuft.
				window.addEventListener("pagereveal", function (e) {
					if (e.viewTransition) r.classList.add("per-uebergang");
				});
				setTimeout(function () {
					if (!r.classList.contains("anim-bereit")) r.classList.remove("bewegt");
				}, 3000);
			})();
		</script>
		<script is:inline>
			// Die Website gibt es nur hell. Ein alter Cookie der früheren
			// Hell/Dunkel-Auswahl wird entfernt.
			if (document.cookie.indexOf("theme=") >= 0) document.cookie = "theme=; path=/; max-age=0; SameSite=Lax";
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class:list={["site-header", { "ueber-bild": ueberBild }]} data-kopfzeile>
			<nav class="nav">
				<a href="/" class="site-logo">
					{siteLogo
						? <img
							src={siteLogo.url}
							alt={siteLogo.alt || siteTitle}
							width={siteLogo.width}
							height={siteLogo.height}
							class="site-logo-img"
						/>
						: <>
							<svg class="logo-zeichen" viewBox="0 0 64 64" aria-hidden="true">
								<polyline points="13,30 32,14 51,30" />
								<polyline points="21,32 21,52 41,52" />
								<polyline points="29,34 29,44 37,44" />
							</svg>
							<span class="logo-text">{siteTitle}</span>
						</>
					}
				</a>
				<div class="nav-links">
					{
						menu?.items.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</div>
				<div class="nav-actions">
					{isLoggedIn && <a href="/_emdash/admin" class="nav-admin">Admin</a>}
					<button
						type="button"
						class="menue-knopf"
						data-menue-knopf
						aria-expanded="false"
						aria-controls="menue"
						aria-label="Menü öffnen"
					>
						<span class="punkte" aria-hidden="true">
							<i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
						</span>
					</button>
				</div>
			</nav>
		</header>

		<div class="menue" id="menue" data-menue hidden>
			<nav class="menue-inhalt" aria-label="Hauptmenü">
				<ol class="menue-liste">
					{[
						{ label: "Startseite", url: "/" },
						{ label: "Modelle", url: "/#modelle" },
						{ label: "So funktioniert es", url: "/#ablauf" },
						{ label: "Über uns", url: "/ueber-uns" },
						...(menu?.items ?? []).map((item) => ({ label: item.label, url: item.url })),
						{ label: "Kontakt", url: "/kontakt" },
					].map((eintrag, i) => (
						<li style={`--n: ${i}`}>
							<a href={eintrag.url} data-menue-link>
								<span class="menue-nr">{String(i + 1).padStart(2, "0")}</span>
								<span class="menue-wort"><span>{eintrag.label}</span></span>
							</a>
						</li>
					))}
				</ol>
				<div class="menue-fuss">
					<a href="/impressum" data-menue-link>Impressum</a>
					<a href="/datenschutz" data-menue-link>Datenschutz</a>
				</div>
			</nav>
		</div>

		<main>
			<slot />
		</main>

		<footer class="site-footer" id="kontakt">
			<div class="footer-content">
				<div class="footer-brand">
					<span class="footer-logo">
						{siteLogo
								? <img
									src={siteLogo.url}
									alt={siteLogo.alt || siteTitle}
									width={siteLogo.width}
									height={siteLogo.height}
									class="footer-logo-img"
								/>
							: siteTitle
						}
					</span>
					<p class="footer-tagline">
						{settings?.tagline || ""}
					</p>
				</div>
				{footerWidgets.map((widget) => (
					<div class="footer-kontakt">
						{widget.title && <h4>{widget.title}</h4>}
						{widget.type === "content" && widget.content && (
							<PortableText value={widget.content} />
						)}
					</div>
				))}
				{footerColumns.length > 0 && (
				<div class="footer-links">
					{
						footerColumns.map((col) => (
							<div class="footer-col">
								<h4>{col.heading}</h4>
								{col.menu!.items.map((item) => (
									<a
										href={item.url}
										target={item.target}
										rel={item.target ? "noopener noreferrer" : undefined}>
										{item.label}
									</a>
								))}
							</div>
						))
					}
				</div>
				)}
			</div>
			<div class="footer-bottom">
				<p>
					&copy; {new Date().getFullYear()} {siteTitle}. Alle Rechte vorbehalten.
				</p>
				<nav class="footer-recht" aria-label="Rechtliches">
					<a href="/ueber-uns">Über uns</a>
					<a href="/kontakt">Kontakt</a>
					<a href="/impressum">Impressum</a>
					<a href="/datenschutz">Datenschutz</a>
				</nav>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Das Formular-Plugin liefert Textfelder (Nachricht) mit Leerzeichen und
			// Tabs vorbefüllt aus. Dadurch startet der Cursor mitten im Feld, und ein
			// "leeres" Pflichtfeld gilt als ausgefüllt. Hier werden sie geleert.
			document.querySelectorAll<HTMLTextAreaElement>(".ec-form textarea").forEach((feld) => {
				if (!feld.value.trim()) feld.value = "";
			});
		</script>

		<script>
			import { animationenStarten, formularErfolgStarten } from "../lib/animationen";
			import { kopfzeileStarten } from "../lib/menue";
			animationenStarten();
			kopfzeileStarten();
			formularErfolgStarten();
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				/* Farben in src/styles/tokens.css und theme.css. Nur helles Design:
				   theme.css setzt color-scheme: light, unabhängig vom Gerät. */

				html {
					scroll-behavior: smooth;
				}

				@media (prefers-reduced-motion: reduce) {
					html {
						scroll-behavior: auto;
					}

					*,
					*::before,
					*::after {
						scroll-behavior: auto !important;
						transition-duration: 0.01ms !important;
					}
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: currentColor;
					text-decoration: none;
				}

					/* Bare links in authored content need a visible style; component
					   links restyle themselves via classes. */
				p a:not([class]),
				li a:not([class]) {
					color: var(--color-brand);
					text-decoration: underline;
					text-underline-offset: 2px;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					font-weight: var(--font-weight-heading);
					line-height: var(--leading-snug);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-size: var(--font-size-5xl);
				}
				h2 {
					font-size: var(--font-size-3xl);
				}
				h3 {
					font-size: var(--font-size-2xl);
				}
				h4 {
					font-size: var(--font-size-xl);
				}

				/* Utility classes */
				.container {
					max-width: var(--wide-width);
					margin: 0 auto;
					padding: 0 var(--spacing-lg);
				}

				.section {
					padding: var(--spacing-5xl) 0;
				}

				.section-header {
					text-align: center;
					max-width: var(--max-width);
					margin: 0 auto var(--spacing-4xl);
				}

				.section-headline {
					font-size: var(--font-size-3xl);
					font-weight: var(--font-weight-display);
				}

				.section-subheadline {
					margin-top: var(--spacing-md);
					font-size: var(--font-size-lg);
					color: var(--color-muted);
				}

				.icon-tile {
					width: 48px;
					height: 48px;
					display: flex;
					align-items: center;
					justify-content: center;
					flex-shrink: 0;
					font-size: 1.5rem;
					color: var(--color-on-brand);
					background: var(--gradient-brand);
					border-radius: var(--radius);
				}

				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: var(--spacing-sm);
					padding: var(--spacing-sm) var(--spacing-lg);
					font-family: inherit;
					font-size: var(--font-size-sm);
					font-weight: 600;
					border-radius: var(--radius);
					cursor: pointer;
					transition:
						background var(--transition-fast),
						transform var(--transition-fast),
						box-shadow var(--transition-fast);
				}

				.btn:hover {
					transform: translateY(-1px);
				}

				.btn:active {
					transform: translateY(0);
				}

				.btn-primary {
					color: var(--color-on-brand);
					background: var(--gradient-brand-strong);
					border: none;
					transition:
						background 0.3s ease,
						box-shadow 0.3s ease,
						transform var(--transition-fast);
				}

				.btn-primary:hover {
					background: var(--gradient-brand);
					box-shadow: var(--shadow-lg);
				}

				.btn-secondary {
					color: var(--color-text);
					background: transparent;
					border: 1px solid var(--color-border);
				}

				.btn-secondary:hover {
					background: var(--color-surface);
					border-color: var(--color-muted);
				}

				.btn-lg {
					padding: var(--spacing-md) var(--spacing-xl);
					font-size: var(--font-size-base);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: var(--color-bg);
				border-bottom: 1px solid var(--color-border);
			}

			.nav {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-md) var(--spacing-lg);
				display: flex;
				flex-wrap: nowrap;
				align-items: center;
				gap: var(--spacing-lg);
			}

			.site-logo {
				font-family: var(--font-heading);
				font-size: var(--font-size-lg);
				font-weight: 500;
				letter-spacing: 0.32em;
				text-transform: uppercase;
				color: var(--color-text);
				display: inline-flex;
				align-items: center;
				gap: 0.85rem;
			}

			/* Haus-Zeichen neben dem Namen: nur Linien, ganz in Gold (Logo-Variante 4) */
			.logo-zeichen {
				width: 26px;
				height: 26px;
				flex-shrink: 0;
				fill: none;
				stroke: #b8975a;
				stroke-width: 4.5;
				stroke-linecap: square;
			}

			.site-logo-img {
				height: 48px;
				width: auto;
				display: block;
				margin: -8px 0;
			}

			.nav-links {
				display: flex;
				flex-wrap: wrap;
				gap: var(--spacing-lg);
				margin-left: auto;
			}

			.nav-links a {
				font-size: var(--font-size-sm);
				font-weight: 500;
				color: var(--color-muted);
				transition: color var(--transition-fast);
			}

			.nav-links a:hover {
				color: var(--color-text);
			}

			.nav-actions {
				display: flex;
				align-items: center;
				gap: var(--spacing-lg);
			}

			.nav-admin {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				opacity: 0.5;
			}

			/* Compact variant of .btn.btn-primary for the header */
			.nav-cta {
				padding: 0.7rem 1.4rem;
				border-radius: 0;
			}

			main {
				min-height: calc(100vh - 200px);
			}

			.site-footer {
				background: var(--color-surface);
				border-top: 1px solid var(--color-border);
			}

			.footer-content {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-4xl) var(--spacing-lg) var(--spacing-2xl);
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: var(--spacing-4xl);
			}

			.footer-logo {
				font-family: var(--font-heading);
				font-size: var(--font-size-xl);
				font-weight: 400;
				letter-spacing: var(--tracking-tight);
			}

			.footer-logo-img {
				height: 24px;
				width: auto;
			}

			.footer-kontakt {
				font-style: normal;
				font-size: var(--font-size-sm);
				line-height: 1.7;
			}

			.footer-kontakt h4 {
				font-size: var(--font-size-sm);
				font-weight: 600;
				margin-bottom: var(--spacing-md);
			}

			.footer-kontakt :global(p) {
				white-space: pre-line;
			}

			.footer-kontakt :global(p + p) {
				margin-top: var(--spacing-sm);
			}

			.footer-kontakt :global(a:hover) {
				color: var(--color-brand);
			}

			.footer-tagline {
				margin-top: var(--spacing-sm);
				font-size: var(--font-size-sm);
				color: var(--color-muted);
			}

			.footer-links {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--spacing-xl);
			}

			.footer-col h4 {
				font-size: var(--font-size-sm);
				font-weight: 600;
				margin-bottom: var(--spacing-md);
			}

			.footer-col a {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				padding: var(--spacing-xs) 0;
				transition: color var(--transition-fast);
			}

			.footer-col a:hover {
				color: var(--color-text);
			}

			.footer-bottom {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-lg);
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				border-top: 1px solid var(--color-border);
			}

			.footer-recht {
				display: flex;
				gap: var(--spacing-lg);
			}

			.footer-recht a:hover {
				color: var(--color-text);
			}

			.footer-powered a {
				color: var(--color-text);
			}

			@media (max-width: 768px) {
				.footer-content {
					grid-template-columns: 1fr;
					gap: var(--spacing-2xl);
				}

				.footer-links {
					grid-template-columns: repeat(2, 1fr);
				}

				.footer-bottom {
					flex-direction: column;
					gap: var(--spacing-md);
					text-align: center;
				}

				h1 {
					font-size: var(--font-size-4xl);
				}
				h2 {
					font-size: var(--font-size-2xl);
				}
			}

			@media (max-width: 540px) {
				/* Auf schmalen Handys nur das Zeichen, damit der Kontakt-Button Platz hat */
				.logo-text {
					position: absolute;
					width: 1px;
					height: 1px;
					overflow: hidden;
					clip: rect(0 0 0 0);
					white-space: nowrap;
				}

				.logo-zeichen {
					width: 30px;
					height: 30px;
				}

				.nav {
					flex-wrap: wrap;
					row-gap: var(--spacing-md);
					justify-content: space-between;
				}

				.nav-links {
					order: 3;
					width: 100%;
					justify-content: flex-end;
					margin-left: 0;
				}
			}

			@media (max-width: 480px) {
				.footer-links {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
