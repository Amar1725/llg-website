{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ludwiglivinggroup",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "ludwiglivinggroup.de", "custom_domain": true },
		{ "pattern": "www.ludwiglivinggroup.de", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-test-eu",
			"database_id": "030762ec-976d-4525-acc6-6504b5f15225"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-test-media"
		}
	],
	"triggers": {
		"crons": ["0 2 * * *"]
	}
}
