{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ludwiglivinggroup",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Übergang ins Konto des Kunden: zuerst nur über workers.dev testen.
	// Die Domains (routes) kommen erst dazu, wenn die Domain im neuen Konto liegt.
	"workers_dev": true,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ludwiglivinggroup-db",
			"database_id": "d620bb9c-0768-4aa2-b11d-a6a418ce44f3"
		}
	],
	// Sitzungs-Speicher für Anmeldungen (fest eingetragen, damit der Build ihn nicht neu anlegen will)
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "b076d71a1250418cb62c923c9628cba6"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "ludwiglivinggroup-media",
			"jurisdiction": "eu"
		}
	],
	"triggers": {
		"crons": ["0 2 * * *"]
	}
}
