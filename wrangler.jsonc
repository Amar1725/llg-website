{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ludwiglivinggroup",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// workers.dev-Adresse eingeschaltet, solange die Domain auf Strato zeigt:
	// https://ludwiglivinggroup.ludwiglivinggroup.workers.dev
	"workers_dev": true,
	"preview_urls": false,
	"routes": [
		{ "pattern": "ludwiglivinggroup.de", "custom_domain": true },
		{ "pattern": "www.ludwiglivinggroup.de", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ludwiglivinggroup-daten",
			"database_id": "c39e5ce6-63e5-4560-8d1d-c85f52bc25be"
		}
	],
	// Sitzungs-Speicher für Anmeldungen (fest eingetragen, damit der Build ihn nicht neu anlegen will)
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "b076d71a1250418cb62c923c9628cba6"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "ludwiglivinggroup-media",
			"jurisdiction": "eu"
		}
	],
	"triggers": {
		"crons": ["0 2 * * *"]
	}
}
