{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ludwiglivinggroup",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Übergang ins Konto des Kunden: zuerst nur über workers.dev testen.
	// Die Domains (routes) kommen erst dazu, wenn die Domain im neuen Konto liegt.
	"workers_dev": true,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ludwiglivinggroup-db",
			"database_id": "83a61769-33a9-48ec-b56d-f0b1673ff5e6"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "ludwiglivinggroup-media",
			"jurisdiction": "eu"
		}
	],
	"triggers": {
		"crons": ["0 2 * * *"]
	}
}
